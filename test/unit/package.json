{
	"name": "@wordpress/unit-tests",
	"version": "0.0.0",
	"description": "Unit tests for WordPress Gutenberg.",
	"private": true,
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"unit-tests"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/test/unit/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "test/unit"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"devDependencies": {
		"@emotion/styled": "^11.14.1",
		"@flakiness/vitest": "^1.9.0",
		"@swc/plugin-emotion": "^14.19.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@typescript-eslint/parser": "^8.57.1",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/browser-playwright": "^4.1.10",
		"@wordpress/html-entities": "file:../../packages/html-entities",
		"@wordpress/scripts": "file:../../packages/scripts",
		"@wordpress/video-conversion": "file:../../packages/video-conversion",
		"@wordpress/vips": "file:../../packages/vips",
		"@wordpress/vitest-console": "file:../../packages/vitest-console",
		"@wordpress/vitest-preset-default": "file:../../packages/vitest-preset-default",
		"client-zip": "^2.4.5",
		"fast-glob": "^3.2.7",
		"jsdom": "^26.1.0",
		"playwright": "^1.62.1",
		"resize-observer-polyfill": "^1.5.1",
		"timezone-mock": "^1.3.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"yargs": "^17.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:unit": "vitest run --config vitest.config.mjs",
		"test:unit:conventions": "node scripts/validate-vitest-conventions.mjs",
		"test:unit:no-jest": "node scripts/validate-no-jest.mjs",
		"test:unit:packages": "node scripts/validate-vitest-package-consumer.mjs",
		"test:unit:vitest": "npm run test:unit --",
		"test:unit:profile": "wp-scripts --cpu-prof test-unit-js --run --config vitest.config.mjs --no-file-parallelism --maxWorkers=1",
		"test:unit:watch": "vitest --config vitest.config.mjs",
		"test:unit:debug": "wp-scripts --inspect-brk test-unit-js --run --config vitest.config.mjs --no-file-parallelism --maxWorkers=1"
	}
}
