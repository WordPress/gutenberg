{
	"name": "@wordpress/unit-tests",
	"version": "0.0.0",
	"description": "Unit tests for WordPress Gutenberg.",
	"private": true,
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"unit-tests"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/test/unit/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "test/unit"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"devDependencies": {
		"@emotion/styled": "^11.14.1",
		"@flakiness/vitest": "^1.9.2",
		"@swc/plugin-emotion": "^16.0.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@typescript-eslint/parser": "^8.68.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/browser-playwright": "^5.0.0",
		"@wordpress/html-entities": "file:../../packages/html-entities",
		"@wordpress/video-conversion": "file:../../packages/video-conversion",
		"@wordpress/vips": "file:../../packages/vips",
		"client-zip": "^2.4.5",
		"glob": "^13.0.6",
		"jsdom": "^26.1.0",
		"playwright": "^1.63.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"resize-observer-polyfill": "^1.5.1",
		"timezone-mock": "^1.3.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"yargs": "^17.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:unit": "vitest run --config vitest.config.mjs",
		"test:unit:conventions": "node scripts/validate-vitest-conventions.mjs",
		"test:unit:date": "node scripts/run-date-tests.mts",
		"test:unit:vitest": "vitest run --config vitest.config.mjs",
		"test:unit:vitest:shuffled": "npm run test:unit:vitest -- --sequence.shuffle.files --sequence.shuffle.tests --sequence.seed=80855",
		"test:unit:vitest:update": "vitest run --config vitest.config.mjs --update=true",
		"test:unit:vitest:watch": "vitest --config vitest.config.mjs",
		"test:unit:profile": "vitest run --config vitest.config.mjs --pool=forks --no-file-parallelism --execArgv=--cpu-prof",
		"test:unit:watch": "npm run test:unit -- --watch",
		"test:unit:debug": "vitest --config vitest.config.mjs --inspect-brk --no-file-parallelism --watch=false",
		"test:unit:routing": "node scripts/validate-test-routing.mjs"
	}
}
