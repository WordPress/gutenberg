{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"checkJs": false,
		"forceConsistentCasingInFileNames": true,
		"module": "CommonJS",
		"noEmit": true,
		// the following 5 lines are needed else the missing file errors shows up on build. If there is a better solution, update this config.
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"declarationDir": null,
		"emitDeclarationOnly": false,
		"rootDir": "../..",
		"types": [ "node" ]
	},
	"include": [ "." ],
	"exclude": []
}
