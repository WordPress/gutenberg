{
	"name": "@wordpress/integration-tests",
	"version": "0.0.0",
	"description": "Integration tests for WordPress Gutenberg.",
	"private": true,
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"integration-tests"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/test/integration/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "test/integration"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"devDependencies": {
		"@wordpress/scripts": "file:../../packages/scripts",
		"ajv": "^8.17.1",
		"fast-glob": "^3.2.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:integration": "wp-scripts test-unit-js --config jest.config.js",
		"test:integration:watch": "npm run test:integration -- --watch",
		"test:integration:debug": "wp-scripts --inspect-brk test-unit-js --runInBand --no-cache --verbose --config jest.config.js"
	}
}
