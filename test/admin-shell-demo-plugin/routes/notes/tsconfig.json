{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"rootDir": ".",
		"noEmit": true,
		"emitDeclarationOnly": false,
		"composite": false
	},
	"references": [
		{
			"path": "../../../../packages/admin-ui/tsconfig.build.json"
		},
		{
			"path": "../../../../packages/components/tsconfig.build.json"
		},
		{
			"path": "../../../../packages/element/tsconfig.build.json"
		},
		{
			"path": "../../../../packages/i18n/tsconfig.build.json"
		},
		{
			"path": "../../../../packages/ui/tsconfig.build.json"
		}
	],
	"include": [ "**/*.ts", "**/*.tsx" ],
	"exclude": [ "build", "node_modules" ]
}
