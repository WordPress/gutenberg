{
	"name": "@wordpress/stylelint-config",
	"version": "24.3.0",
	"description": "stylelint config for WordPress development.",
	"author": "The WordPress Contributors",
	"license": "MIT",
	"keywords": [
		"stylelint",
		"stylelint-config",
		"stylelint-config-wordpress",
		"wordpress"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/stylelint-config/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/stylelint-config"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"index.js",
		"scss.js",
		"scss-stylistic.js",
		"stylistic.js"
	],
	"type": "module",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./scss": "./scss.js",
		"./scss-stylistic": "./scss-stylistic.js",
		"./stylistic": "./stylistic.js",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@stylistic/stylelint-plugin": "^5.2.1",
		"@wordpress/theme": "file:../theme",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-config-recommended-scss": "^17.0.1"
	},
	"devDependencies": {
		"@wordpress/npm-package-json-lint-config": "file:../npm-package-json-lint-config",
		"stylelint": "^17.14.1",
		"stylelint-scss": "^7.2.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"stylelint": "^17.14.1",
		"stylelint-scss": "^7.2.0"
	},
	"npmpackagejsonlint": {
		"extends": "@wordpress/npm-package-json-lint-config",
		"rules": {
			"valid-values-license": [
				"error",
				[
					"MIT"
				]
			]
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
