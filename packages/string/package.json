{
	"name": "@wordpress/string",
	"version": "1.0.0-prerelease",
	"description": "String utilities for WordPress development.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"string",
		"kebab-case"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/string/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/string"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-types",
		"*.md"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"default": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"wpScript": false,
	"types": "build-types",
	"sideEffects": false,
	"dependencies": {
		"change-case": "^4.1.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
