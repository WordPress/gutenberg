{
	"name": "@wordpress/post-picker",
	"version": "1.0.0-prerelease",
	"description": "A modal for searching and selecting posts, pages, and other post types.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"post",
		"picker"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/post-picker/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/post-picker"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types",
		"*.md"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json",
		"./build-style/*": "./build-style/*"
	},
	"wpScript": true,
	"types": "build-types",
	"dependencies": {
		"@wordpress/base-styles": "file:../base-styles",
		"@wordpress/components": "file:../components",
		"@wordpress/core-data": "file:../core-data",
		"@wordpress/data": "file:../data",
		"@wordpress/dataviews": "file:../dataviews",
		"@wordpress/element": "file:../element",
		"@wordpress/html-entities": "file:../html-entities",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/ui": "file:../ui"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"@types/react-dom": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"@types/react-dom": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
