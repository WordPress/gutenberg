{
	"name": "@wordpress/ultrahdr",
	"version": "1.0.0-prerelease",
	"private": true,
	"description": "UltraHDR (ISO 21496-1) gain map support for WordPress Gutenberg.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"media",
		"ultrahdr",
		"hdr",
		"gain-map"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/ultrahdr/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/ultrahdr"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-types",
		"*.md"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"default": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"types": "build-types",
	"dependencies": {
		"@wordpress/ultrahdr-wasm": "file:../ultrahdr-wasm"
	},
	"publishConfig": {
		"access": "public"
	}
}
