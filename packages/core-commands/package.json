{
	"name": "@wordpress/core-commands",
	"version": "1.57.0",
	"description": "WordPress core reusable commands.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"commands"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/core-commands/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/core-commands"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-types"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"wpScript": true,
	"types": "build-types",
	"sideEffects": false,
	"dependencies": {
		"@wordpress/commands": "file:../commands",
		"@wordpress/compose": "file:../compose",
		"@wordpress/core-data": "file:../core-data",
		"@wordpress/data": "file:../data",
		"@wordpress/element": "file:../element",
		"@wordpress/html-entities": "file:../html-entities",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/icons": "file:../icons",
		"@wordpress/private-apis": "file:../private-apis",
		"@wordpress/router": "file:../router",
		"@wordpress/url": "file:../url"
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
