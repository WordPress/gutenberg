{
	"name": "@wordpress/lazy-import",
	"version": "2.57.0",
	"description": "Lazily import a module, installing it automatically if missing.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"import"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/lazy-import/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/lazy-import"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0"
	},
	"files": [
		"build",
		"build-types",
		"src",
		"*.md"
	],
	"main": "build/index.cjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"default": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"types": "build-types/index.d.ts",
	"dependencies": {
		"execa": "^4.0.2",
		"npm-package-arg": "^8.1.5",
		"semver": "^7.5.4"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/npm-package-arg": "^6.1.1",
		"@types/semver": "^7.3.8",
		"vitest": "^5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
