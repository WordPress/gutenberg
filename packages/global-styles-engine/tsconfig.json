{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"checkJs": false,
		"typeRoots": [
			"../../typings",
			"./node_modules/@types",
			// This is for the packages with in-built types.
			"./node_modules"
		],
		"types": [
			"gutenberg-env",
			"gutenberg-test-env",
			// From @types/*
			"jest",
			// Inbuilt types
			"@testing-library/jest-dom"
		]
	},
	"references": [
		{ "path": "../data" },
		{ "path": "../i18n" },
		{ "path": "../style-engine" }
	]
}
