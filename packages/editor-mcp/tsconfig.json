{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"outDir": "build",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [ "node" ],
		"declaration": true,
		"resolveJsonModule": true,
		"sourceMap": true
	},
	"include": [ "src/**/*" ]
}
