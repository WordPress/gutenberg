{
	"name": "@wordpress/content-guidelines",
	"version": "0.1.0",
	"description": "Content Guidelines management for WordPress.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"content-guidelines"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/content-guidelines/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/content-guidelines"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScript": true,
	"types": "build-types",
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss"
	],
	"dependencies": {
		"@wordpress/api-fetch": "file:../api-fetch",
		"@wordpress/components": "file:../components",
		"@wordpress/compose": "file:../compose",
		"@wordpress/data": "file:../data",
		"@wordpress/dataviews": "file:../dataviews",
		"@wordpress/date": "file:../date",
		"@wordpress/dom-ready": "file:../dom-ready",
		"@wordpress/element": "file:../element",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/icons": "file:../icons",
		"@wordpress/notices": "file:../notices"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
