{
	"name": "@wordpress/edit-site",
	"version": "6.40.0",
	"description": "Edit Site Page module for WordPress.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"editor",
		"site"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/edit-site/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/edit-site"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types",
		"*.md"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"default": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScript": true,
	"wpScriptExtraDependencies": [
		"wp-dom-ready"
	],
	"dependencies": {
		"@react-spring/web": "^9.4.5",
		"@wordpress/a11y": "workspace:*",
		"@wordpress/admin-ui": "workspace:*",
		"@wordpress/api-fetch": "workspace:*",
		"@wordpress/base-styles": "workspace:*",
		"@wordpress/blob": "workspace:*",
		"@wordpress/block-editor": "workspace:*",
		"@wordpress/block-library": "workspace:*",
		"@wordpress/blocks": "workspace:*",
		"@wordpress/commands": "workspace:*",
		"@wordpress/components": "workspace:*",
		"@wordpress/compose": "workspace:*",
		"@wordpress/core-data": "workspace:*",
		"@wordpress/data": "workspace:*",
		"@wordpress/dataviews": "workspace:*",
		"@wordpress/date": "workspace:*",
		"@wordpress/deprecated": "workspace:*",
		"@wordpress/dom": "workspace:*",
		"@wordpress/editor": "workspace:*",
		"@wordpress/element": "workspace:*",
		"@wordpress/escape-html": "workspace:*",
		"@wordpress/fields": "workspace:*",
		"@wordpress/global-styles-engine": "workspace:*",
		"@wordpress/global-styles-ui": "workspace:*",
		"@wordpress/hooks": "workspace:*",
		"@wordpress/html-entities": "workspace:*",
		"@wordpress/i18n": "workspace:*",
		"@wordpress/icons": "workspace:*",
		"@wordpress/keyboard-shortcuts": "workspace:*",
		"@wordpress/keycodes": "workspace:*",
		"@wordpress/media-utils": "workspace:*",
		"@wordpress/notices": "workspace:*",
		"@wordpress/patterns": "workspace:*",
		"@wordpress/plugins": "workspace:*",
		"@wordpress/preferences": "workspace:*",
		"@wordpress/primitives": "workspace:*",
		"@wordpress/private-apis": "workspace:*",
		"@wordpress/reusable-blocks": "workspace:*",
		"@wordpress/router": "workspace:*",
		"@wordpress/style-engine": "workspace:*",
		"@wordpress/url": "workspace:*",
		"@wordpress/viewport": "workspace:*",
		"@wordpress/views": "workspace:*",
		"@wordpress/widgets": "workspace:*",
		"@wordpress/wordcount": "workspace:*",
		"change-case": "^4.1.2",
		"clsx": "^2.1.1",
		"colord": "^2.9.2",
		"fast-deep-equal": "^3.1.3",
		"memize": "^2.1.0",
		"react-autosize-textarea": "^7.1.0"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
