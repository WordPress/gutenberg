{
	"name": "@wordpress/theme-build-tools",
	"version": "1.0.0-prerelease",
	"description": "Build plugins and Stylelint rules for the WordPress Design System design tokens.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"design-system",
		"design-tokens",
		"stylelint",
		"postcss",
		"lightningcss",
		"esbuild",
		"vite"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/theme-build-tools/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "packages/theme-build-tools"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0"
	},
	"files": [
		"build-types",
		"*-plugins/**",
		"lib/**",
		"*.md",
		"!build-types/**/*.d.mts.map",
		"!build-types/**/*.d.ts.map",
		"!**/test/**"
	],
	"type": "module",
	"exports": {
		"./postcss-plugins/postcss-ds-token-fallbacks": {
			"types": "./build-types/postcss-plugins/postcss-ds-token-fallbacks.d.mts",
			"default": "./postcss-plugins/postcss-ds-token-fallbacks.mjs"
		},
		"./lightningcss-plugins/lightningcss-ds-token-fallbacks": {
			"types": "./build-types/lightningcss-plugins/lightningcss-ds-token-fallbacks.d.mts",
			"default": "./lightningcss-plugins/lightningcss-ds-token-fallbacks.mjs"
		},
		"./esbuild-plugins/esbuild-ds-token-fallbacks": {
			"types": "./build-types/esbuild-plugins/esbuild-ds-token-fallbacks.d.mts",
			"default": "./esbuild-plugins/esbuild-ds-token-fallbacks.mjs"
		},
		"./vite-plugins/vite-ds-token-fallbacks": {
			"types": "./build-types/vite-plugins/vite-ds-token-fallbacks.d.mts",
			"default": "./vite-plugins/vite-ds-token-fallbacks.mjs"
		},
		"./stylelint-plugins/no-unknown-ds-tokens": {
			"types": "./build-types/stylelint-plugins/no-unknown-ds-tokens.d.mts",
			"default": "./stylelint-plugins/no-unknown-ds-tokens.mjs"
		},
		"./stylelint-plugins/no-setting-wpds-custom-properties": {
			"types": "./build-types/stylelint-plugins/no-setting-wpds-custom-properties.d.mts",
			"default": "./stylelint-plugins/no-setting-wpds-custom-properties.mjs"
		},
		"./stylelint-plugins/no-token-fallback-values": {
			"types": "./build-types/stylelint-plugins/no-token-fallback-values.d.mts",
			"default": "./stylelint-plugins/no-token-fallback-values.mjs"
		},
		"./package.json": "./package.json"
	},
	"wpScript": false,
	"sideEffects": false,
	"dependencies": {
		"@babel/parser": "^7.28.6",
		"@babel/types": "^7.29.7",
		"@jridgewell/remapping": "^2.3.5",
		"@jridgewell/trace-mapping": "^0.3.31",
		"magic-string": "^0.30.21"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@wordpress/theme": "file:../theme",
		"@wordpress/validation-tools": "file:../../tools/validation",
		"esbuild": "^0.27.2",
		"lightningcss": "^1.33.0",
		"postcss": "^8.4.38",
		"source-map": "^0.6.1",
		"stylelint": "^17.14.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@wordpress/theme": "^3.0.0",
		"esbuild": ">=0.27.2 <1.0.0",
		"lightningcss": ">=1.33.0 <2.0.0",
		"postcss": "^8.0.0",
		"stylelint": "^16 || ^17",
		"vite": "^7 || ^8"
	},
	"peerDependenciesMeta": {
		"@wordpress/theme": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"lightningcss": {
			"optional": true
		},
		"postcss": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint:package-contents": "wp-validate-package-contents . --disallow-path test"
	}
}
