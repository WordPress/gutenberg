{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"declarationDir": "build-types",
		"moduleResolution": "bundler",
		"rootDir": ".",
		"types": [ "node" ]
	},
	"include": [ "*-plugins/*.mjs", "lib/*.mjs" ],
	"exclude": [
		"**/test/**",
		"**/tests/**",
		"**/__tests__/**",
		"**/stories/**",
		"**/*.story.*"
	],
	"references": [
		{ "path": "../theme/tsconfig.build.json" },
		{ "path": "../theme/tsconfig.prebuilt.json" }
	]
}
