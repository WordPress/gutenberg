{
	"name": "@wordpress/block-editor",
	"version": "15.9.0",
	"description": "Generic block editor.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"editor",
		"blocks"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/block-editor/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/block-editor"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types",
		"*.md"
	],
	"type": "module",
	"main": "build/index.cjs",
	"module": "build-module/index.js",
	"exports": {
		".": {
			"import": "./build-module/index.js",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json",
		"./build-style/": "./build-style/"
	},
	"react-native": "src/index",
	"wpScript": true,
	"wpScriptModuleExports": {
		"./utils/fit-text-frontend": "./build-module/utils/fit-text-frontend.js"
	},
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss",
		"src/index.js",
		"src/store/index.js",
		"src/hooks/**",
		"build/index.cjs",
		"build/store/index.cjs",
		"build/hooks/**",
		"build-module/index.js",
		"build-module/store/index.js",
		"build-module/hooks/**"
	],
	"dependencies": {
		"@react-spring/web": "^9.4.5",
		"@wordpress/a11y": "workspace:../a11y",
		"@wordpress/api-fetch": "workspace:../api-fetch",
		"@wordpress/base-styles": "workspace:../base-styles",
		"@wordpress/blob": "workspace:../blob",
		"@wordpress/block-serialization-default-parser": "workspace:../block-serialization-default-parser",
		"@wordpress/blocks": "workspace:../blocks",
		"@wordpress/commands": "workspace:../commands",
		"@wordpress/components": "workspace:../components",
		"@wordpress/compose": "workspace:../compose",
		"@wordpress/data": "workspace:../data",
		"@wordpress/dataviews": "workspace:../dataviews",
		"@wordpress/date": "workspace:../date",
		"@wordpress/deprecated": "workspace:../deprecated",
		"@wordpress/dom": "workspace:../dom",
		"@wordpress/element": "workspace:../element",
		"@wordpress/escape-html": "workspace:../escape-html",
		"@wordpress/global-styles-engine": "workspace:../global-styles-engine",
		"@wordpress/hooks": "workspace:../hooks",
		"@wordpress/html-entities": "workspace:../html-entities",
		"@wordpress/i18n": "workspace:../i18n",
		"@wordpress/icons": "workspace:../icons",
		"@wordpress/image-cropper": "workspace:../image-cropper",
		"@wordpress/interactivity": "workspace:../interactivity",
		"@wordpress/is-shallow-equal": "workspace:../is-shallow-equal",
		"@wordpress/keyboard-shortcuts": "workspace:../keyboard-shortcuts",
		"@wordpress/keycodes": "workspace:../keycodes",
		"@wordpress/notices": "workspace:../notices",
		"@wordpress/preferences": "workspace:../preferences",
		"@wordpress/priority-queue": "workspace:../priority-queue",
		"@wordpress/private-apis": "workspace:../private-apis",
		"@wordpress/rich-text": "workspace:../rich-text",
		"@wordpress/style-engine": "workspace:../style-engine",
		"@wordpress/token-list": "workspace:../token-list",
		"@wordpress/upload-media": "workspace:../upload-media",
		"@wordpress/url": "workspace:../url",
		"@wordpress/warning": "workspace:../warning",
		"@wordpress/wordcount": "workspace:../wordcount",
		"change-case": "^4.1.2",
		"clsx": "^2.1.1",
		"colord": "^2.7.0",
		"deepmerge": "^4.3.0",
		"diff": "^4.0.2",
		"fast-deep-equal": "^3.1.3",
		"memize": "^2.1.0",
		"parsel-js": "^1.1.2",
		"postcss": "^8.4.21",
		"postcss-prefix-selector": "^1.16.0",
		"postcss-urlrebase": "^1.4.0",
		"react-autosize-textarea": "^7.1.0",
		"react-easy-crop": "^5.0.6",
		"remove-accents": "^0.5.0"
	},
	"devDependencies": {
		"@ariakit/test": "^0.4.7",
		"deep-freeze": "0.0.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
