{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"references": [
		{ "path": "../a11y/tsconfig.build.json" },
		{ "path": "../block-editor/tsconfig.build.json" },
		{ "path": "../blocks" },
		{ "path": "../components/tsconfig.build.json" },
		{ "path": "../compose/tsconfig.build.json" },
		{ "path": "../core-data/tsconfig.build.json" },
		{ "path": "../data" },
		{ "path": "../element/tsconfig.build.json" },
		{ "path": "../html-entities/tsconfig.build.json" },
		{ "path": "../i18n/tsconfig.build.json" },
		{ "path": "../icons/tsconfig.build.json" },
		{ "path": "../notices/tsconfig.build.json" },
		{ "path": "../private-apis" },
		{ "path": "../ui/tsconfig.build.json" },
		{ "path": "../url" }
	],
	/*
	 * Only the TypeScript sources are checked. The JavaScript sources stay
	 * unchecked, and the package stays untyped for its consumers through the
	 * `paths` of the base configuration.
	 */
	"include": [ "src/**/*.ts", "src/**/*.tsx" ]
}
