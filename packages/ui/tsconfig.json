{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.dev.base.json",
	"compilerOptions": {
		"types": [
			"jest",
			"gutenberg-env",
			"style-imports",
			"react-css-custom-properties"
		]
	},
	"files": [ "global.d.ts" ],
	"include": [
		"src/**/test/**/*.ts",
		"src/**/test/**/*.tsx",
		"src/**/tests/**/*.ts",
		"src/**/tests/**/*.tsx",
		"src/**/__tests__/**/*.ts",
		"src/**/__tests__/**/*.tsx"
	],
	"references": [
		{ "path": "./tsconfig.build.json" },
		{ "path": "../a11y/tsconfig.build.json" },
		{ "path": "../compose/tsconfig.build.json" },
		{ "path": "../element/tsconfig.build.json" },
		{ "path": "../i18n/tsconfig.build.json" },
		{ "path": "../icons/tsconfig.build.json" },
		{ "path": "../keycodes/tsconfig.build.json" },
		{ "path": "../primitives" },
		{ "path": "../private-apis" },
		{ "path": "../style-runtime/tsconfig.build.json" },
		{ "path": "../theme/tsconfig.build.json" }
	]
}
