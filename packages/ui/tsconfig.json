{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"typeRoots": [
			"./node_modules/@types",
			// This is for the packages with in-built types.
			"./node_modules"
		],
		"types": [
			// From @types/*
			"jest",
			"node",
			// Inbuilt types
			"@testing-library/jest-dom"
		]
	},
	"references": [
		{ "path": "../element" },
		{ "path": "../i18n" },
		{ "path": "../theme" }
	],
	"exclude": []
}
