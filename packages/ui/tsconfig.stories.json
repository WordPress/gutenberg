{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	/*
	 * Storybook's component meta extractor needs stories and component
	 * sources in one project; tests stay in the dev project with jest.
	 */
	"compilerOptions": {
		"noEmit": true,
		"emitDeclarationOnly": false,
		"types": [
			"gutenberg-env",
			"style-imports",
			"react-css-custom-properties"
		]
	},
	"references": [
		{ "path": "../a11y/tsconfig.build.json" },
		{ "path": "../compose/tsconfig.build.json" },
		{ "path": "../element/tsconfig.build.json" },
		{ "path": "../i18n/tsconfig.build.json" },
		{ "path": "../icons" },
		{ "path": "../keycodes/tsconfig.build.json" },
		{ "path": "../primitives" },
		{ "path": "../private-apis" },
		{ "path": "../style-runtime" },
		{ "path": "../theme/tsconfig.build.json" }
	]
}
