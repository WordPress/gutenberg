{
	"name": "@wordpress/core-fields",
	"version": "0.1.0-prerelease",
	"description": "The fields WordPress core registers on the server for the Fields API: their PHP declarations and their JavaScript parts.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"dataviews",
		"fields",
		"core"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/core-fields/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/core-fields"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0"
	},
	"files": [
		"src",
		"build-module",
		"build-types",
		"*.md"
	],
	"module": "build-module/post_supports/index.mjs",
	"exports": {
		"./post_supports": {
			"types": "./build-types/post_supports/index.d.ts",
			"import": "./build-module/post_supports/index.mjs"
		},
		"./wp_template": {
			"types": "./build-types/wp_template/index.d.ts",
			"import": "./build-module/wp_template/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"wpScriptModuleExports": {
		"./post_supports": "./build-module/post_supports/index.mjs",
		"./wp_template": "./build-module/wp_template/index.mjs"
	},
	"wpCopyFiles": {
		"files": [
			"src/**/*.php"
		],
		"transforms": {
			"php": {
				"functionPrefix": "gutenberg_",
				"prefixFunctions": [
					"wp_register_field_collection"
				]
			}
		}
	},
	"types": "build-types",
	"sideEffects": false,
	"dependencies": {
		"@wordpress/core-data": "file:../core-data",
		"@wordpress/data": "file:../data",
		"@wordpress/element": "file:../element",
		"@wordpress/fields-loader": "file:../fields-loader",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/icons": "file:../icons",
		"@wordpress/ui": "file:../ui",
		"clsx": "^2.1.1"
	},
	"devDependencies": {
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"@types/react-dom": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"@types/react-dom": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
