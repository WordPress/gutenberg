{
	"name": "@wordpress/block-library",
	"version": "9.36.0",
	"description": "Block library for the WordPress editor.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"blocks"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/block-library/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/block-library"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types",
		"*.md",
		"babel-plugin.cjs"
	],
	"type": "module",
	"main": "build/index.cjs",
	"module": "build-module/index.js",
	"exports": {
		".": {
			"import": "./build-module/index.js",
			"require": "./build/index.cjs"
		},
		"./babel-plugin": "./babel-plugin.cjs",
		"./build-module/*": "./build-module/*",
		"./build-style/*": "./build-style/*",
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScript": true,
	"wpScriptModuleExports": {
		"./accordion/view": "./build-module/accordion/view.js",
		"./file/view": "./build-module/file/view.js",
		"./form/view": "./build-module/form/view.js",
		"./image/view": "./build-module/image/view.js",
		"./navigation/view": "./build-module/navigation/view.js",
		"./query/view": "./build-module/query/view.js",
		"./search/view": "./build-module/search/view.js",
		"./tabs/view": "./build-module/tabs/view.js"
	},
	"wpStyleEntryPoints": [
		"src/*.scss",
		"src/*/style.scss",
		"src/*/editor.scss",
		"src/*/theme.scss"
	],
	"wpCopyFiles": {
		"files": [
			"src/**/*.php",
			"src/*/block.json"
		],
		"transforms": {
			"php": {
				"functionPrefix": "gutenberg_",
				"classSuffix": "_Gutenberg",
				"prefixFunctions": [
					"wp_apply_colors_support",
					"wp_enqueue_block_support_styles",
					"wp_get_typography_font_size_value",
					"wp_style_engine_get_styles",
					"wp_get_global_settings"
				],
				"suffixClasses": [
					"WP_Navigation_Block_Renderer"
				],
				"addActionPriority": 20,
				"flattenIndexFiles": true
			}
		}
	},
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss",
		"src/*/init.js",
		"build/*/init.js",
		"build-module/*/init.js"
	],
	"dependencies": {
		"@wordpress/a11y": "workspace:../a11y",
		"@wordpress/api-fetch": "workspace:../api-fetch",
		"@wordpress/autop": "workspace:../autop",
		"@wordpress/base-styles": "workspace:../base-styles",
		"@wordpress/blob": "workspace:../blob",
		"@wordpress/block-editor": "workspace:../block-editor",
		"@wordpress/blocks": "workspace:../blocks",
		"@wordpress/components": "workspace:../components",
		"@wordpress/compose": "workspace:../compose",
		"@wordpress/core-data": "workspace:../core-data",
		"@wordpress/data": "workspace:../data",
		"@wordpress/date": "workspace:../date",
		"@wordpress/deprecated": "workspace:../deprecated",
		"@wordpress/dom": "workspace:../dom",
		"@wordpress/element": "workspace:../element",
		"@wordpress/escape-html": "workspace:../escape-html",
		"@wordpress/hooks": "workspace:../hooks",
		"@wordpress/html-entities": "workspace:../html-entities",
		"@wordpress/i18n": "workspace:../i18n",
		"@wordpress/icons": "workspace:../icons",
		"@wordpress/interactivity": "workspace:../interactivity",
		"@wordpress/interactivity-router": "workspace:../interactivity-router",
		"@wordpress/keyboard-shortcuts": "workspace:../keyboard-shortcuts",
		"@wordpress/keycodes": "workspace:../keycodes",
		"@wordpress/latex-to-mathml": "workspace:../latex-to-mathml",
		"@wordpress/notices": "workspace:../notices",
		"@wordpress/patterns": "workspace:../patterns",
		"@wordpress/primitives": "workspace:../primitives",
		"@wordpress/private-apis": "workspace:../private-apis",
		"@wordpress/reusable-blocks": "workspace:../reusable-blocks",
		"@wordpress/rich-text": "workspace:../rich-text",
		"@wordpress/server-side-render": "workspace:../server-side-render",
		"@wordpress/url": "workspace:../url",
		"@wordpress/viewport": "workspace:../viewport",
		"@wordpress/wordcount": "workspace:../wordcount",
		"change-case": "^4.1.2",
		"clsx": "^2.1.1",
		"colord": "^2.7.0",
		"escape-html": "^1.0.3",
		"fast-average-color": "^9.1.1",
		"fast-deep-equal": "^3.1.3",
		"html-react-parser": "5.2.11",
		"memize": "^2.1.0",
		"remove-accents": "^0.5.0",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"deep-freeze": "0.0.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
