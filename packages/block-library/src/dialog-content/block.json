{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/dialog-content",
	"version": "1.0.0",
	"title": "Dialog Content",
	"description": "Displays content in a modal dialog that appears on top of the page.",
	"category": "media",
	"__experimental": true,
	"attributes": {
		"animationDuration": {
			"type": "number",
			"default": 400
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"inserter": false,
		"lock": false,
		"reusable": false,
		"animations": true,
		"listView": true,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"enableContrastChecker": true
		},
		"layout": {
			"allowEditing": true,
			"allowJustification": false
		},
		"shadow": {
			"__experimentalDefaultControls": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		},
		"spacing": {
			"blockGap": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"__experimentalFontFamily": true
			}
		},
		"interactivity": true
	},
	"usesContext": [
		"core/dialog-id",
		"core/dialog-isDialogOpen",
		"core/dialog-isDialogLocked",
		"core/dialog-label"
	],
	"parent": [ "core/dialog" ],
	"textdomain": "dialog-content",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
