{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,

	"name": "core/post-breadcrumbs",
	"title": "Post Breadcrumbs",
	"category": "theme",
	"description": "Display a breadcrumb trail for hierarchical posts.",
	"textdomain": "default",
	"attributes": {
		"separator": {
			"type": "string",
			"default": "/"
		},
		"showHomeLink": {
			"type": "boolean",
			"default": true
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"reusable": false
	},
	"style": "wp-block-post-breadcrumbs"
}
