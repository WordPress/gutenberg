{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/dialog",
	"version": "1.0.0",
	"title": "Dialog Wrapper",
	"description": "A container that pairs a trigger element with a dialog, enabling interactive modal experiences.",
	"category": "media",
	"keywords": [ "dialog", "modal", "popup" ],
	"__experimental": true,
	"allowedBlocks": [ "core/dialog-trigger", "core/dialog-element" ],
	"attributes": {
		"editorIsDialogOpen": {
			"type": "boolean",
			"role": "local",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide", "left", "right", "center" ],
		"interactivity": true
	},
	"providesContext": {
		"core/dialog-isDialogOpen": "editorIsDialogOpen"
	},
	"usesContext": [ "core/dialog-id" ],
	"textdomain": "dialog",
	"editorScript": "file:./index.js"
}
