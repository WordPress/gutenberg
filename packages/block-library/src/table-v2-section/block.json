{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/table-v2-section",
	"title": "Table Section",
	"category": "text",
	"parent": [ "core/table-v2" ],
	"description": "A section of a table (head, body, or foot).",
	"textdomain": "default",
	"allowedBlocks": [ "core/table-v2-row" ],
	"attributes": {
		"type": {
			"type": "string",
			"default": "body"
		}
	},
	"supports": {
		"anchor": false,
		"html": false,
		"listView": false,
		"movable": false,
		"removable": false,
		"reusable": false,
		"inserter": false,
		"editingMode": "disabled",
		"interactivity": {
			"clientNavigation": true
		}
	}
}
