{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"__experimental": true,
	"apiVersion": 3,
	"name": "core/slider",
	"title": "Slider",
	"description": "Display content in a scrolling slider.",
	"category": "design",
	"textdomain": "default",
	"allowedBlocks": [ "core/slider-pagination", "core/slide" ],
	"attributes": {
		"slidesToShow": {
			"type": "integer",
			"default": 1
		},
		"loop": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"ariaLabel": true,
		"html": false,
		"interactivity": true,
		"layout": {
			"default": {
				"type": "flex",
				"orientation": "vertical"
			},
			"allowOrientation": true,
			"allowJustification": false
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "wp-block-slider",
	"viewScriptModule": "@wordpress/block-library/slider/view"
}
