{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"__experimental": true,
	"apiVersion": 3,
	"name": "core/slider",
	"title": "Slider",
	"description": "Display content in a scrolling slider.",
	"category": "design",
	"textdomain": "default",
	"allowedBlocks": [ "core/slide" ],
	"attributes": {
		"slidesToShow": {
			"type": "integer",
			"default": 1
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"arrowIcon": {
			"type": "string",
			"enum": [ "chevron", "arrow" ],
			"default": "chevron"
		},
		"indicatorStyle": {
			"type": "string",
			"enum": [ "dot", "line" ],
			"default": "dot"
		},
		"navigationButtonType": {
			"type": "string",
			"enum": [ "icon", "text", "both" ],
			"default": "icon"
		},
		"arrowsPosition": {
			"type": "string",
			"enum": [ "overlay", "sides", "top", "bottom", "none" ],
			"default": "overlay"
		},
		"indicatorsPosition": {
			"type": "string",
			"enum": [ "overlay", "top", "bottom", "none" ],
			"default": "overlay"
		}
	},
	"supports": {
		"align": true,
		"ariaLabel": true,
		"html": false,
		"interactivity": true,
		"layout": {
			"default": {
				"type": "flex",
				"orientation": "vertical"
			},
			"allowOrientation": true,
			"allowJustification": false
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "wp-block-slider",
	"viewScriptModule": "@wordpress/block-library/slider/view"
}
