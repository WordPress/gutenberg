{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/overlay-close",
	"title": "Overlay Close",
	"category": "design",
	"description": "A button to close navigation overlays.",
	"keywords": [ "close", "overlay", "navigation", "menu" ],
	"textdomain": "default",
	"attributes": {
		"displayMode": {
			"type": "string",
			"enum": [ "icon", "text", "both" ],
			"default": "icon"
		},
		"text": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": "span",
			"default": "Close"
		}
	},
	"supports": {
		"anchor": true,
		"color": {
			"__experimentalSkipSerialization": true,
			"gradients": false,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"__experimentalSkipSerialization": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"typography": {
			"__experimentalSkipSerialization": true,
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"editorStyle": "wp-block-overlay-close-editor",
	"style": "wp-block-overlay-close"
}
