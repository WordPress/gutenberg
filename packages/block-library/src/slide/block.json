{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"__experimental": true,
	"apiVersion": 3,
	"name": "core/slide",
	"title": "Slide",
	"description": "A single slide within a slider.",
	"category": "design",
	"textdomain": "default",
	"parent": [ "core/slider-track" ],
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false,
		"spacing": {
			"blockGap": true,
			"padding": true,
			"margin": false
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "wp-block-slide-editor",
	"style": "wp-block-slide"
}
