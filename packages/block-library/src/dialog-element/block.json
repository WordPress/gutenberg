{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/dialog-element",
	"version": "1.0.0",
	"title": "Dialog",
	"description": "A dialog is a modal window that appears on top of the current page. It is used to display content that requires the user's attention or interaction.",
	"category": "media",
	"__experimental": true,
	"attributes": {
		"dialogLabel": {
			"type": "string",
			"default": ""
		},
		"backdropColor": {
			"type": "string"
		},
		"customBackdropColor": {
			"type": "string"
		},
		"autoActivateOnRender": {
			"type": "boolean",
			"default": false
		},
		"autoActivationTimer": {
			"type": "number",
			"default": -1
		},
		"animationDuration": {
			"type": "number",
			"default": 400
		},
		"enableDeepLink": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"inserter": false,
		"lock": false,
		"reusable": false,
		"animations": true,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"enableContrastChecker": true
		},
		"layout": {
			"allowEditing": true,
			"allowJustification": false
		},
		"shadow": true,
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"blockGap": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"__experimentalFontFamily": true
			}
		},
		"interactivity": true
	},
	"usesContext": [ "core/dialog-id", "core/dialog-isDialogOpen" ],
	"providesContext": {
		"core/dialog-label": "dialogLabel"
	},
	"parent": [ "core/dialog" ],
	"textdomain": "dialog-element",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "@wordpress/block-library/dialog-element/view"
}
