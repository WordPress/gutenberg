{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"__experimental": true,
	"apiVersion": 3,
	"name": "core/slider-pagination-button",
	"title": "Slider Pagination Button",
	"description": "Navigation button for a slider.",
	"category": "design",
	"textdomain": "default",
	"ancestor": [ "core/slider-pagination" ],
	"attributes": {
		"type": {
			"type": "string",
			"enum": [ "previous", "next" ],
			"default": "previous"
		}
	},
	"usesContext": [ "arrowIcon" ],
	"supports": {
		"anchor": false,
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"style": "wp-block-slider-pagination-button"
}
