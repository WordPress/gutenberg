			"removed": [ "core/bold" ]
		}
	],
	"expect": {
		"all-accepted": "<i>word</i>",
		"all-rejected": "word"
	},
	"cases": [
		{
			"decisions": { "A": "reject", "B": "accept" },
			"published": "<i>word</i>"
		},
		{
			"decisions": { "A": "accept", "B": "reject" },
			"published": "<b>word</b>"
