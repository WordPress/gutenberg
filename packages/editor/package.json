{
	"name": "@wordpress/editor",
	"version": "14.36.0",
	"description": "Enhanced block editor for WordPress posts.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"editor"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/editor/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/editor"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types",
		"*.md"
	],
	"type": "module",
	"main": "build/index.cjs",
	"module": "build-module/index.js",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.js",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScript": true,
	"types": "build-types",
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss",
		"src/index.js",
		"src/store/index.js",
		"src/hooks/**",
		"src/bindings/**",
		"build/index.cjs",
		"build/store/index.cjs",
		"build/hooks/**",
		"build/bindings/**",
		"build-module/index.js",
		"build-module/store/index.js",
		"build-module/hooks/**",
		"build-module/bindings/**"
	],
	"dependencies": {
		"@floating-ui/react-dom": "2.0.8",
		"@wordpress/a11y": "workspace:../a11y",
		"@wordpress/api-fetch": "workspace:../api-fetch",
		"@wordpress/base-styles": "workspace:../base-styles",
		"@wordpress/blob": "workspace:../blob",
		"@wordpress/block-editor": "workspace:../block-editor",
		"@wordpress/blocks": "workspace:../blocks",
		"@wordpress/commands": "workspace:../commands",
		"@wordpress/components": "workspace:../components",
		"@wordpress/compose": "workspace:../compose",
		"@wordpress/core-data": "workspace:../core-data",
		"@wordpress/data": "workspace:../data",
		"@wordpress/dataviews": "workspace:../dataviews",
		"@wordpress/date": "workspace:../date",
		"@wordpress/deprecated": "workspace:../deprecated",
		"@wordpress/dom": "workspace:../dom",
		"@wordpress/element": "workspace:../element",
		"@wordpress/fields": "workspace:../fields",
		"@wordpress/global-styles-engine": "workspace:../global-styles-engine",
		"@wordpress/global-styles-ui": "workspace:../global-styles-ui",
		"@wordpress/hooks": "workspace:../hooks",
		"@wordpress/html-entities": "workspace:../html-entities",
		"@wordpress/i18n": "workspace:../i18n",
		"@wordpress/icons": "workspace:../icons",
		"@wordpress/interface": "workspace:../interface",
		"@wordpress/keyboard-shortcuts": "workspace:../keyboard-shortcuts",
		"@wordpress/keycodes": "workspace:../keycodes",
		"@wordpress/media-utils": "workspace:../media-utils",
		"@wordpress/notices": "workspace:../notices",
		"@wordpress/patterns": "workspace:../patterns",
		"@wordpress/plugins": "workspace:../plugins",
		"@wordpress/preferences": "workspace:../preferences",
		"@wordpress/private-apis": "workspace:../private-apis",
		"@wordpress/reusable-blocks": "workspace:../reusable-blocks",
		"@wordpress/rich-text": "workspace:../rich-text",
		"@wordpress/server-side-render": "workspace:../server-side-render",
		"@wordpress/url": "workspace:../url",
		"@wordpress/warning": "workspace:../warning",
		"@wordpress/wordcount": "workspace:../wordcount",
		"change-case": "^4.1.2",
		"client-zip": "^2.4.5",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"fast-deep-equal": "^3.1.3",
		"memize": "^2.1.0",
		"react-autosize-textarea": "^7.1.0",
		"remove-accents": "^0.5.0",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"deep-freeze": "0.0.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
