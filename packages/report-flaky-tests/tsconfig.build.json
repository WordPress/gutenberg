{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// The action runs straight from these sources on Node's type stripping,
		// which resolves relative imports by their real `.ts` extension.
		"allowImportingTsExtensions": true
	},
	"exclude": [
		"**/benchmark",
		"**/test/**",
		"**/tests/**",
		"**/__tests__/**",
		"**/stories/**",
		"**/*.story.*",
		"src/__fixtures__"
	]
}
