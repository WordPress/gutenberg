{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// The action runs straight from these sources on Node's type stripping,
		// which resolves relative imports by their real `.ts` extension.
		"allowImportingTsExtensions": true,
		"types": [ "jest" ]
	},
	"exclude": [ "src/__tests__", "src/__fixtures__" ]
}
