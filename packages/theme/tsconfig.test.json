{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"emitDeclarationOnly": false,
		"noEmit": true,
		"rootDir": ".",
		"types": [
			"jest",
			"node",
			"style-imports",
			"react-css-custom-properties"
		]
	},
	"references": [ { "path": "./tsconfig.json" } ],
	"files": [ "global.d.ts" ],
	"include": [
		"src/**/stories/**/*",
		"src/**/test/**/*",
		"src/**/*.story.*"
	],
	"exclude": []
}
