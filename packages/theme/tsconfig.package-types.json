{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declarationDir": "build-package-types",
		"moduleResolution": "bundler",
		"tsBuildInfoFile": "tsconfig.package-types.tsbuildinfo",
		"types": [ "node", "style-imports", "react-css-custom-properties" ]
	},
	"include": [
		"src/package-types.ts",
		"src/prebuilt/js/design-tokens.mjs",
		"src/prebuilt/ts/token-types.ts",
		"src/stylelint-plugins/*.mjs",
		"src/types.ts"
	],
	"exclude": []
}
