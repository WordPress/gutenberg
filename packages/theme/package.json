{
	"name": "@wordpress/theme",
	"version": "2.3.0",
	"description": "Theme and context provider for the WordPress Design System.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"design-system",
		"design-tokens",
		"theme"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/theme/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "packages/theme"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"files": [
		"build-module",
		"build-types",
		"prebuilt",
		"!build-types/**/*.d.mts.map",
		"!build-types/**/*.d.ts.map",
		"!**/stories/**",
		"!**/test/**"
	],
	"type": "module",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"default": "./build-module/index.mjs"
		},
		"./design-tokens.css": "./prebuilt/css/design-tokens.css",
		"./design-tokens.js": {
			"types": "./build-types/prebuilt/js/design-tokens.d.mts",
			"default": "./prebuilt/js/design-tokens.mjs"
		},
		"./package.json": "./package.json"
	},
	"wpScript": true,
	"sideEffects": [
		"prebuilt/css/design-tokens.css"
	],
	"dependencies": {
		"@wordpress/compose": "file:../compose",
		"@wordpress/deprecated": "file:../deprecated",
		"@wordpress/element": "file:../element",
		"@wordpress/private-apis": "file:../private-apis",
		"@wordpress/style-runtime": "file:../style-runtime",
		"colorjs.io": "^0.7.1",
		"memize": "^2.1.1"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/react-vite": "^10.6.1",
		"@terrazzo/cli": "^2.7.1",
		"@terrazzo/parser": "^2.7.1",
		"@terrazzo/plugin-css": "^2.7.1",
		"@terrazzo/token-tools": "^2.7.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@wordpress/validation-tools": "file:../../tools/validation",
		"postcss": "^8.4.38",
		"prettier": "npm:wp-prettier@^3.9.6",
		"storybook": "^10.6.1",
		"vitest": "^5.0.3",
		"vitest-browser-react": "^2.3.0"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:default-ramps": "node bin/generate-default-ramps/index.ts",
		"build:tokens": "node bin/generate-primitive-tokens/index.ts && node bin/build-design-tokens/index.ts",
		"build:figma": "node bin/build-figma-tokens/index.ts",
		"build": "npm run build:default-ramps && npm run build:tokens && npm run build:figma",
		"lint:package-contents": "wp-validate-package-contents . --disallow-path src",
		"postbuild": "prettier --write tokens/color.json tokens/modes prebuilt src/prebuilt src/color-ramps/lib/default-ramps.ts docs ../base-styles/internal/_wpds-token-fallbacks.scss"
	}
}
