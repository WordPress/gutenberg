{
	"wpds-font": {
		"family": {
			"$type": "fontFamily",
			"heading": {
				"$value": [
					"-apple-system",
					"system-ui",
					"Segoe UI",
					"Roboto",
					"Oxygen-Sans",
					"Ubuntu",
					"Cantarell",
					"Helvetica Neue",
					"sans-serif"
				],
				"$description": "Headings font family"
			},
			"body": {
				"$value": [
					"-apple-system",
					"system-ui",
					"Segoe UI",
					"Roboto",
					"Oxygen-Sans",
					"Ubuntu",
					"Cantarell",
					"Helvetica Neue",
					"sans-serif"
				],
				"$description": "Body font family"
			},
			"mono": {
				"$value": [ "Menlo", "Consolas", "monaco", "monospace" ],
				"$description": "Monospace font family"
			}
		},
		"size": {
			"$type": "dimension",
			"xs": {
				"$value": { "value": 11, "unit": "px" },
				"$description": "Extra small font size"
			},
			"sm": {
				"$value": { "value": 12, "unit": "px" },
				"$description": "Small font size"
			},
			"md": {
				"$value": { "value": 13, "unit": "px" },
				"$description": "Medium font size"
			},
			"lg": {
				"$value": { "value": 15, "unit": "px" },
				"$description": "Large font size"
			},
			"xl": {
				"$value": { "value": 20, "unit": "px" },
				"$description": "Extra large font size"
			},
			"2xl": {
				"$value": { "value": 32, "unit": "px" },
				"$description": "2X large font size"
			},
			"$extensions": {
				"com.figma.scopes": [ "FONT_SIZE" ]
			}
		},
		"line-height": {
			"$type": "dimension",
			"xs": {
				"$value": { "value": 16, "unit": "px" },
				"$description": "Extra small line height"
			},
			"sm": {
				"$value": { "value": 20, "unit": "px" },
				"$description": "Small line height"
			},
			"md": {
				"$value": { "value": 24, "unit": "px" },
				"$description": "Medium line height"
			},
			"lg": {
				"$value": { "value": 28, "unit": "px" },
				"$description": "Large line height"
			},
			"xl": {
				"$value": { "value": 32, "unit": "px" },
				"$description": "Extra large line height"
			},
			"2xl": {
				"$value": { "value": 40, "unit": "px" },
				"$description": "2X large line height"
			},
			"$extensions": {
				"com.figma.scopes": [ "LINE_HEIGHT" ]
			}
		},
		"weight": {
			"$type": "fontWeight",
			"regular": {
				"$value": 400,
				"$description": "Regular font weight for body text"
			},
			"medium": {
				"$value": 500,
				"$description": "Medium font weight for emphasis and headings"
			},
			"$extensions": {
				"com.figma.scopes": [ "FONT_WEIGHT" ]
			}
		},
		"heading": {
			"$type": "typography",
			"2xl": {
				"$value": {
					"fontFamily": "{wpds-font.family.heading}",
					"fontSize": "{wpds-font.size.2xl}",
					"fontWeight": "{wpds-font.weight.medium}",
					"lineHeight": "{wpds-font.line-height.2xl}"
				},
				"$description": "Extra large heading for hero sections"
			},
			"xl": {
				"$value": {
					"fontFamily": "{wpds-font.family.heading}",
					"fontSize": "{wpds-font.size.xl}",
					"fontWeight": "{wpds-font.weight.medium}",
					"lineHeight": "{wpds-font.line-height.md}"
				},
				"$description": "Large heading for page titles"
			},
			"lg": {
				"$value": {
					"fontFamily": "{wpds-font.family.heading}",
					"fontSize": "{wpds-font.size.lg}",
					"fontWeight": "{wpds-font.weight.medium}",
					"lineHeight": "{wpds-font.line-height.sm}"
				},
				"$description": "Medium-large heading for section titles"
			},
			"md": {
				"$value": {
					"fontFamily": "{wpds-font.family.heading}",
					"fontSize": "{wpds-font.size.md}",
					"fontWeight": "{wpds-font.weight.medium}",
					"lineHeight": "{wpds-font.line-height.sm}"
				},
				"$description": "Medium heading for subsections"
			},
			"sm": {
				"$value": {
					"fontFamily": "{wpds-font.family.heading}",
					"fontSize": "{wpds-font.size.xs}",
					"fontWeight": "{wpds-font.weight.medium}",
					"lineHeight": "{wpds-font.line-height.xs}"
				},
				"$description": "Small heading for labels and minor headings"
			}
		},
		"body": {
			"$type": "typography",
			"xl": {
				"$value": {
					"fontFamily": "{wpds-font.family.body}",
					"fontSize": "{wpds-font.size.xl}",
					"fontWeight": "{wpds-font.weight.regular}",
					"lineHeight": "{wpds-font.line-height.xl}"
				},
				"$description": "Large body text for lead paragraphs and introductions"
			},
			"lg": {
				"$value": {
					"fontFamily": "{wpds-font.family.body}",
					"fontSize": "{wpds-font.size.lg}",
					"fontWeight": "{wpds-font.weight.regular}",
					"lineHeight": "{wpds-font.line-height.md}"
				},
				"$description": "Comfortable body text for extended reading"
			},
			"md": {
				"$value": {
					"fontFamily": "{wpds-font.family.body}",
					"fontSize": "{wpds-font.size.md}",
					"fontWeight": "{wpds-font.weight.regular}",
					"lineHeight": "{wpds-font.line-height.sm}"
				},
				"$description": "Default body text for general content"
			},
			"sm": {
				"$value": {
					"fontFamily": "{wpds-font.family.body}",
					"fontSize": "{wpds-font.size.sm}",
					"fontWeight": "{wpds-font.weight.regular}",
					"lineHeight": "{wpds-font.line-height.xs}"
				},
				"$description": "Small body text for help text and secondary content"
			}
		}
	}
}
