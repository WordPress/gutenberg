{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/dev.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"allowImportingTsExtensions": true,
		"types": [
			"gutenberg-vitest-test-env",
			"node",
			"style-imports",
			"react-css-custom-properties"
		]
	},
	"files": [ "global.d.ts" ],
	"include": [
		"src/**/stories/**/*",
		"src/**/test/**/*",
		"src/**/*.story.*"
	],
	"references": [
		{ "path": "./tsconfig.build.json" },
		{ "path": "./tsconfig.prebuilt.json" },
		{ "path": "../compose/tsconfig.build.json" },
		{ "path": "../style-runtime/tsconfig.build.json" }
	]
}
