{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.dev.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"allowImportingTsExtensions": true,
		"types": [
			"jest",
			"node",
			"style-imports",
			"react-css-custom-properties"
		]
	},
	"files": [ "global.d.ts" ],
	"include": [
		"bin",
		"terrazzo.config.ts",
		"*-plugins/test/**/*",
		"src/**/stories/**/*",
		"src/**/test/**/*",
		"src/**/*.story.*"
	],
	"references": [
		{ "path": "./tsconfig.build.json" },
		{ "path": "./tsconfig.plugins.json" },
		{ "path": "../compose/tsconfig.build.json" },
		{ "path": "../style-runtime/tsconfig.build.json" }
	]
}
