{
	"name": "@wordpress/fields",
	"version": "0.49.0",
	"description": "The fields and actions WordPress core registers on the server for the Entity fields and Entity actions APIs: their PHP declarations and the script modules of their JavaScript parts.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"dataviews",
		"fields",
		"actions"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/fields/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/fields"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"files": [
		"src",
		"build-module",
		"build-types",
		"*.md"
	],
	"module": "build-module/entity-fields/post_type_supports/index.mjs",
	"exports": {
		"./package.json": "./package.json"
	},
	"wpScriptModuleExports": {
		"./attachment": "./build-module/entity-fields/attachment/index.mjs",
		"./page": "./build-module/entity-fields/page/index.mjs",
		"./post_type_supports": "./build-module/entity-fields/post_type_supports/index.mjs",
		"./root_site": "./build-module/entity-fields/root_site/index.mjs",
		"./wp_block": "./build-module/entity-fields/wp_block/index.mjs",
		"./wp_template": "./build-module/entity-fields/wp_template/index.mjs",
		"./wp_template_part": "./build-module/entity-fields/wp_template_part/index.mjs",
		"./entity-actions/post_type_supports": {
			"path": "./build-module/entity-actions/post_type_supports/index.mjs",
			"id": "@wordpress/actions/post_type_supports"
		},
		"./entity-actions/wp_block": {
			"path": "./build-module/entity-actions/wp_block/index.mjs",
			"id": "@wordpress/actions/wp_block"
		},
		"./entity-actions/wp_template_part": {
			"path": "./build-module/entity-actions/wp_template_part/index.mjs",
			"id": "@wordpress/actions/wp_template_part"
		}
	},
	"wpCopyFiles": {
		"files": [
			"src/**/*.php"
		],
		"transforms": {
			"php": {
				"functionPrefix": "gutenberg_"
			}
		}
	},
	"sideEffects": [
		"src/**/*.module.css"
	],
	"dependencies": {
		"@wordpress/api-fetch": "file:../api-fetch",
		"@wordpress/blob": "file:../blob",
		"@wordpress/blocks": "file:../blocks",
		"@wordpress/components": "file:../components",
		"@wordpress/compose": "file:../compose",
		"@wordpress/core-data": "file:../core-data",
		"@wordpress/data": "file:../data",
		"@wordpress/dataviews": "file:../dataviews",
		"@wordpress/date": "file:../date",
		"@wordpress/element": "file:../element",
		"@wordpress/html-entities": "file:../html-entities",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/icons": "file:../icons",
		"@wordpress/media-utils": "file:../media-utils",
		"@wordpress/notices": "file:../notices",
		"@wordpress/patterns": "file:../patterns",
		"@wordpress/private-apis": "file:../private-apis",
		"@wordpress/style-runtime": "file:../style-runtime",
		"@wordpress/ui": "file:../ui",
		"@wordpress/url": "file:../url",
		"@wordpress/wordcount": "file:../wordcount",
		"change-case": "^4.1.2",
		"client-zip": "^2.4.5",
		"clsx": "^2.1.1",
		"remove-accents": "^0.5.0"
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"@types/react-dom": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"@types/react-dom": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
