{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"incremental": false,
		"composite": false,
		"module": "Node16",
		"moduleResolution": "node16",
		"noEmit": false,
		"outDir": "build",
		"sourceMap": true,
		"emitDeclarationOnly": false,
		"allowJs": true,
		"checkJs": false
	}
}
