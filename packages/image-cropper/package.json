{
	"name": "@wordpress/image-cropper",
	"version": "2.1.0",
	"description": "A basic image cropper component.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"image cropper",
		"cropper"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/image-cropper/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/image-cropper"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./build-style/*": "./build-style/*",
		"./package.json": "./package.json"
	},
	"types": "build-types",
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss"
	],
	"dependencies": {
		"@wordpress/deprecated": "file:../deprecated",
		"@wordpress/element": "file:../element",
		"@wordpress/i18n": "file:../i18n",
		"@wordpress/image-editor": "file:../image-editor"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@wordpress/components": "file:../components",
		"@wordpress/ui": "file:../ui",
		"vitest": "^5.0.5",
		"vitest-browser-react": "^2.3.0"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
