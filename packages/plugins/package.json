{
	"name": "@wordpress/plugins",
	"version": "7.40.0",
	"description": "Plugins module for WordPress.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"plugins"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/plugins/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/plugins"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-types",
		"*.md"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScript": true,
	"types": "build-types",
	"dependencies": {
		"@wordpress/components": "workspace:*",
		"@wordpress/compose": "workspace:*",
		"@wordpress/deprecated": "workspace:*",
		"@wordpress/element": "workspace:*",
		"@wordpress/hooks": "workspace:*",
		"@wordpress/icons": "workspace:*",
		"@wordpress/is-shallow-equal": "workspace:*",
		"memize": "^2.0.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
