{
	"name": "@wordpress/boot",
	"version": "0.3.0",
	"description": "Minimal boot package for WordPress admin pages.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"boot"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/boot/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/boot"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"files": [
		"src",
		"build-module",
		"build-style",
		"build-types",
		"*.md"
	],
	"type": "module",
	"module": "build-module/index.js",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.js"
		},
		"./package.json": "./package.json"
	},
	"react-native": "src/index",
	"wpScriptModuleExports": "./build-module/index.js",
	"types": "build-types",
	"dependencies": {
		"@wordpress/a11y": "workspace:../a11y",
		"@wordpress/admin-ui": "workspace:../admin-ui",
		"@wordpress/commands": "workspace:../commands",
		"@wordpress/components": "workspace:../components",
		"@wordpress/compose": "workspace:../compose",
		"@wordpress/core-data": "workspace:../core-data",
		"@wordpress/data": "workspace:../data",
		"@wordpress/editor": "workspace:../editor",
		"@wordpress/element": "workspace:../element",
		"@wordpress/html-entities": "workspace:../html-entities",
		"@wordpress/i18n": "workspace:../i18n",
		"@wordpress/icons": "workspace:../icons",
		"@wordpress/keyboard-shortcuts": "workspace:../keyboard-shortcuts",
		"@wordpress/keycodes": "workspace:../keycodes",
		"@wordpress/lazy-editor": "workspace:../lazy-editor",
		"@wordpress/primitives": "workspace:../primitives",
		"@wordpress/private-apis": "workspace:../private-apis",
		"@wordpress/route": "workspace:../route",
		"@wordpress/theme": "workspace:../theme",
		"@wordpress/url": "workspace:../url",
		"clsx": "^2.1.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
