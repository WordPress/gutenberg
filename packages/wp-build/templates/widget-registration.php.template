<?php
/**
 * Dashboard widgets registration - Auto-generated by build process.
 * Registers all dashboard widget script modules.
 * Do not edit this file manually.
 *
 * @package {{PREFIX}}
 */

if ( ! function_exists( '{{PREFIX}}_register_dashboard_widgets' ) ) {
	/**
	 * Register dashboard widget script modules.
	 *
	 * Loads the widget registry and registers render + widget script modules
	 * for each discovered widget. Calls the consumer's registration function
	 * for each widget if it exists.
	 */
	function {{PREFIX}}_register_dashboard_widgets() {
		$registry_file = __DIR__ . '/dashboard-widgets/registry.php';
		if ( ! file_exists( $registry_file ) ) {
			return;
		}

		$widgets = require $registry_file;

		// Load build constants.
		$build_constants = require __DIR__ . '/constants.php';

		$extension = defined( 'SCRIPT_DEBUG' ) && SCRIPT_DEBUG ? '.js' : '.min.js';

		foreach ( $widgets as $widget ) {
			$name          = $widget['name'];
			$render_handle = $widget['render_module'];
			$widget_handle = $widget['widget_module'];

			// Register render script module.
			$render_asset_path = __DIR__ . '/dashboard-widgets/' . $name . '/render.min.asset.php';
			if ( file_exists( $render_asset_path ) ) {
				$render_asset = require $render_asset_path;
				wp_register_script_module(
					$render_handle,
					$build_constants['build_url'] . 'dashboard-widgets/' . $name . '/render' . $extension,
					$render_asset['module_dependencies'] ?? array(),
					$render_asset['version'] ?? false
				);
			}

			// Register widget script module.
			$widget_asset_path = __DIR__ . '/dashboard-widgets/' . $name . '/widget.min.asset.php';
			if ( file_exists( $widget_asset_path ) ) {
				$widget_asset = require $widget_asset_path;
				wp_register_script_module(
					$widget_handle,
					$build_constants['build_url'] . 'dashboard-widgets/' . $name . '/widget' . $extension,
					$widget_asset['module_dependencies'] ?? array(),
					$widget_asset['version'] ?? false
				);
			}

			// Call the consumer's registration function if it exists.
			if ( function_exists( '{{PREFIX}}_register_dashboard_widget' ) ) {
				{{PREFIX}}_register_dashboard_widget( $name, $render_handle, $widget_handle );
			}
		}
	}

	add_action( 'init', '{{PREFIX}}_register_dashboard_widgets' );
}
