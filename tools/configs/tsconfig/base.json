{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"paths": {
			"@wordpress/commands": [
				"../typings/untyped-packages/wordpress-commands.d.ts"
			],
			"@wordpress/block-editor": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/block-library": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/patterns": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/interface": [
				"../typings/untyped-packages/any-module.d.ts"
			]
		},
		"checkJs": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",
		"target": "esnext",
		"module": "preserve",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,

		"skipLibCheck": true,

		/* Strict Type-Checking Options */
		"strict": true,

		/* Additional Checks */
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,

		/* Module Resolution Options */
		"moduleResolution": "bundler",

		"resolveJsonModule": true,

		/*
		 * `../typings` is this workspace's own. The other two are repo-root
		 * anchors that have no workspace-local spelling: the vitest globals
		 * belong to `test/unit`, and `@types` packages hoist to the root
		 * install.
		 */
		"typeRoots": [
			"../typings",
			"../../../test/unit/typings",
			"../../../node_modules/@types"
		],
		"types": [],

		"rootDir": "${configDir}/src",
		"declarationDir": "${configDir}/build-types"
	},
	"include": [ "${configDir}/src" ],
	"exclude": [
		"${configDir}/**/benchmark",
		"${configDir}/build-*/**",
		"${configDir}/build/**",
		"${configDir}/**/test/**",
		"${configDir}/**/tests/**",
		"${configDir}/**/__tests__/**",
		"${configDir}/**/stories/**",
		"${configDir}/**/*.story.*"
	]
}
