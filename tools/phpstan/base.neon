# Base PHPStan configuration for Gutenberg
#
# This is kept separate from the main PHPStan configuration file to allow for easy overloading while baseline errors are being fixed.
#
# https://phpstan.org/config-reference

parameters:
	# Cache is stored locally, so it's available for CI.
	tmpDir: ../../.cache/phpstan

	# The supported PHP versions, so the results do not depend on the version PHPStan runs on.
	phpVersion:
		min: 70400
		max: 80500

	# If it's not enforced by PHP we can't assume users are passing valid values.
	treatPhpDocTypesAsCertain: false

	# What directories and files should be analyzed.
	paths:
		- ../../gutenberg.php
		- ../../lib
		# Package PHP that WordPress core ships, copied or synced from here, so this is the only
		# place it can be analyzed.
		- ../../packages/block-library/src
		- ../../packages/block-serialization-default-parser
		- ../../packages/core-actions/src
		- ../../packages/core-fields/src
		- ../../packages/icons/src
		- ../../packages/style-engine/src
		- ../../packages/widgets/src
		# The PHP generated from the wp-build templates, which core also ships. The templates are
		# not valid PHP themselves, so only the generated files can be analyzed.
		- ../../build/constants.php
		- ../../build/pages.php
		- ../../build/pages
		- ../../build/routes.php
		- ../../build/routes
	excludePaths:
		analyseAndScan:
			# Locally installed npm dependencies, which may include PHP files.
			- */node_modules/*
		analyse:
			- ../../packages/block-serialization-default-parser/test
	bootstrapFiles:
		- bootstrap.php
	# The polyfills that WordPress provides for newer PHP functions.
	scanFiles:
		- polyfills.php
	# Constants defined in the bootstrap whose values depend on the site's configuration.
	dynamicConstantNames:
		- MEDIA_TRASH
	# The PHP files generated by the build, which define the gutenberg_* functions and *_Gutenberg classes
	# that lib/ calls. Run `npm run build` before analyzing.
	scanDirectories:
		- ../../build
