# Base PHPStan configuration for Gutenberg
#
# This is kept separate from the main PHPStan configuration file to allow for easy overloading while baseline errors are being fixed.
#
# https://phpstan.org/config-reference

includes:
	# The templates from which the build generates PHP that core also ships. They are rendered
	# into valid PHP before parsing, by WpBuildTemplateParser, so errors point at their lines.
	- wp-build-templates.php

parameters:
	# Cache is stored locally, so it's available for CI.
	tmpDir: ../../.cache/phpstan

	# The supported PHP versions, so the results do not depend on the version PHPStan runs on.
	phpVersion:
		min: 70400
		max: 80500

	# If it's not enforced by PHP we can't assume users are passing valid values.
	treatPhpDocTypesAsCertain: false

	# What directories and files should be analyzed.
	paths:
		- ../../gutenberg.php
		- ../../lib
		# Package PHP that WordPress core ships, copied or synced from here, so this is the only
		# place it can be analyzed.
		- ../../packages/block-library/src
		- ../../packages/block-serialization-default-parser
		- ../../packages/core-actions/src
		- ../../packages/core-fields/src
		- ../../packages/icons/src
		- ../../packages/style-engine/src
		- ../../packages/widgets/src
	fileExtensions:
		- php
		- template
	excludePaths:
		analyseAndScan:
			# Locally installed npm dependencies, which may include PHP files.
			- */node_modules/*
		analyse:
			- ../../packages/block-serialization-default-parser/test
	# WordPress itself is declared by the stubs that szepeviktor/phpstan-wordpress loads, which are
	# generated from core trunk, or from a core pull request that a change depends on, by
	# generate-wordpress-stubs.sh, and installed from wordpress-stubs/.
	bootstrapFiles:
		- bootstrap.php
	# The polyfills that WordPress provides for newer PHP functions.
	scanFiles:
		- polyfills.stub
		# The WordPress test library, which wp-env provides at runtime, for a local configuration that
		# adds phpunit to the paths.
		- ../../vendor/php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
	# Constants defined in the bootstrap whose values depend on the site's configuration.
	dynamicConstantNames:
		- MEDIA_TRASH
	# The PHP files generated by the build, which define the gutenberg_* functions and *_Gutenberg classes
	# that lib/ calls. Run `npm run build` before analyzing.
	scanDirectories:
		- ../../build

services:
	# Renders the wp-build templates into valid PHP before they are parsed, in place of the parsers
	# that PHPStan uses for analyzed files and for discovering the symbols a file declares. If a
	# PHPStan update renames these services, the templates fail to parse and are reported as syntax
	# errors, or the functions they declare as not found, so the analysis does not silently skip them.
	wpBuildTemplateWrappedRichParser:
		class: PHPStan\Parser\RichParser
		arguments:
			parser: @currentPhpVersionPhpParser
		autowired: false
	currentPhpVersionRichParser:
		class: Gutenberg\PHPStan\WpBuildTemplateParser
		arguments:
			parser: @wpBuildTemplateWrappedRichParser
		autowired: false
	wpBuildTemplateWrappedSimpleParser:
		class: PHPStan\Parser\SimpleParser
		arguments:
			parser: @currentPhpVersionPhpParser
		autowired: false
	currentPhpVersionSimpleDirectParser:
		class: Gutenberg\PHPStan\WpBuildTemplateParser
		arguments:
			parser: @wpBuildTemplateWrappedSimpleParser
		autowired: false
