         * @phpstan-param array{
         *   type?: string,
         *   selector?: string,
         *   settings?: string[],
         *   primary_setting?: string,
         *   capability?: string,
         *   render_callback?: callable,
         *   container_inclusive?: bool,
         *   fallback_refresh?: bool,
         * } $args
         */
