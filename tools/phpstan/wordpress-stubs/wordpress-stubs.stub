         *
         * @var \League\OAuth2\Client\Token\AccessToken
         */
        protected $oauthToken;
        /**
         * The user's email address, usually used as the login ID
         * and also the from address when sending email.
         *
         * @var string
         */
        protected $oauthUserEmail = '';
        /**
