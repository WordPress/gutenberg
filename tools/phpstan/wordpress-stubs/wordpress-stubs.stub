     *     $css_rules = array(
     *         array(
     *             'selector'     => '.elephant-are-cool',
     *             'declarations' => array(
     *                 'color' => 'gray',
     *                 'width' => '3em',
     *             ),
     *         ),
     *     );
     *
     *     $css = wp_style_engine_get_stylesheet_from_css_rules( $css_rules );
