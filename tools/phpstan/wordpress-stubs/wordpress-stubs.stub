         *     $smilies->to_array() === array(
         *         '8O' => '😯',
         *         ':(' => '🙁',
         *         ':)' => '🙂',
         *         ':?' => '😕',
         *     );
         *
         * @since 6.6.0
         *
         * @return array The lookup key/substitution values as an associate array.
