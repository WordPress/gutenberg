         *                                                   - 'last_updated'
         *                                                   - 'registered'
         *                                                   - 'domain_length'
         *                                                   - 'path_length'
         *                                                   - 'site__in'
         *                                                   - 'network__in'
         *                                                   - 'deleted'
         *                                                   - 'mature'
         *                                                   - 'spam'
         *                                                   - 'archived'
         *                                                   - 'public'
