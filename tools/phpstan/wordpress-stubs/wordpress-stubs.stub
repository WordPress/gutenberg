        /**
         * Parsed ID.
         *
         * @since 4.5.0
         * @var array {
         *     @type string $base ID base.
         *     @type array  $keys Keys for multidimensional.
         * }
         * @phpstan-var array{
         *   base: string,
         *   keys: array,
         * }
         */
        protected $id_data = array();
