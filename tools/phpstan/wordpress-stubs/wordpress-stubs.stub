     * @since   2.0.0
     */
    final class Port
    {
        /**
         * Port to use with Acap requests.
         *
         * @var int
         */
        const ACAP = 674;
        /**
         * Port to use with Dictionary requests.
         *
         * @var int
         */
        const DICT = 2628;
        /**
         * Port to use with HTTP requests.
         *
         * @var int
         */
        const HTTP = 80;
        /**
         * Port to use with HTTP over SSL requests.
