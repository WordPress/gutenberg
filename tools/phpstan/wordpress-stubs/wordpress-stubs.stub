     * @see WP_Site_Query::__construct() for accepted arguments.
     */
    #[\AllowDynamicProperties]
    class WP_Site_Query
    {
        /**
         * SQL for database query.
         *
         * @since 4.6.0
         * @var string
         */
        public $request;
        /**
         * SQL query clauses.
         *
         * @since 4.6.0
         * @var array
         */
