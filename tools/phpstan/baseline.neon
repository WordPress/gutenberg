parameters:
	ignoreErrors:
		-
			message: '#^Method WP_Duotone_Gutenberg\:\:get_all_global_style_block_names\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: ../../lib/class-wp-duotone-gutenberg.php

		-
			message: '#^Parameter \#1 \$id \(int\) of method WP_REST_Global_Styles_Controller_Gutenberg\:\:prepare_links\(\) should be compatible with parameter \$post \(WP_Post\) of method WP_REST_Posts_Controller\:\:prepare_links\(\)$#'
			identifier: method.childParameterType
			count: 1
			path: ../../lib/class-wp-rest-global-styles-controller-gutenberg.php

		-
			message: '#^Method WP_Theme_JSON_Gutenberg\:\:get_block_name_from_metadata_path\(\) should return string\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: ../../lib/class-wp-theme-json-gutenberg.php

		-
			message: '#^Method WP_Theme_JSON_Gutenberg\:\:get_block_selectors\(\) should return object but returns array\<string, array\<string, string\>\|string\>\.$#'
			identifier: return.type
			count: 1
			path: ../../lib/class-wp-theme-json-gutenberg.php

		-
			message: '#^Parameter \#1 \$css of method WP_Theme_JSON_Gutenberg\:\:process_blocks_custom_css\(\) expects string, array given\.$#'
			identifier: argument.type
			count: 1
			path: ../../lib/class-wp-theme-json-gutenberg.php

		-
			message: '#^Call to function method_exists\(\) with ''WP_Interactivity_API'' and ''add_client…'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: ../../lib/client-assets.php

		-
			message: '#^Access to an undefined property WP_Post\:\:\$content\.$#'
			identifier: property.notFound
			count: 2
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^Access to an undefined property WP_Post\:\:\$type\.$#'
			identifier: property.notFound
			count: 2
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^Function gutenberg_output_block_nav_menu\(\) never returns string so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: ../../lib/experimental/navigation-theme-opt-in.php

		-
			message: '#^Call to function is_array\(\) with array\<mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: ../../packages/block-library/src/navigation/index.php

		-
			message: '#^Call to function method_exists\(\) with ''WP_Theme_JSON…'' and ''get_viewport_media…'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: ../../packages/block-library/src/navigation/index.php

		-
			message: '#^Function block_core_navigation_get_classic_menu_fallback\(\) should return object but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: ../../packages/block-library/src/navigation/index.php

		-
			message: '#^Right side of \|\| is always true\.$#'
			identifier: booleanOr.rightAlwaysTrue
			count: 1
			path: ../../packages/block-library/src/template-part/index.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: ../../packages/style-engine/src/class-wp-style-engine-css-rules-store.php

		-
			message: '#^Parameter \#1 \$style_value of static method WP_Style_Engine\:\:get_slug_from_preset_value\(\) expects string, array given\.$#'
			identifier: argument.type
			count: 1
			path: ../../packages/style-engine/src/class-wp-style-engine.php
