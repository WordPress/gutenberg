# Copy this file to `.env` in the same directory. Git ignores `.env`.
# Values that are already in the environment take precedence over this file.

# Any API that accepts System One decision requests works. These values use
# Clef-flash on Cloudflare Workers AI. Replace <account-id> with your Cloudflare
# account ID, from AI > Workers AI > Use REST API. It is not a credential.
DECISION_API_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/run/@cf/cloudflare/clef-flash
DECISION_MODEL=clef-flash

# The API key. For Cloudflare, an API token with Workers AI permission.
DECISION_API_KEY=

# A GitHub token is optional. Without GITHUB_TOKEN, the tool uses `gh auth token`
# when the GitHub CLI is signed in.
