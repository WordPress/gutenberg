{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"noEmit": true,
		"checkJs": false,
		"forceConsistentCasingInFileNames": true
	},
	"include": [ "./**/*.js", "./**/*.mjs", "./**/*.ts" ]
}
