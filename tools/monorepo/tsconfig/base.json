{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"paths": {
			"@wordpress/commands": [
				"../typings/untyped-packages/wordpress-commands.d.ts"
			],
			"@wordpress/block-editor": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/block-library": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/patterns": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/interface": [
				"../typings/untyped-packages/any-module.d.ts"
			]
		},
		"checkJs": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",
		"target": "esnext",
		"module": "preserve",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,

		"skipLibCheck": true,

		/* Strict Type-Checking Options */
		"strict": true,

		/* Additional Checks */
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,

		/* Module Resolution Options */
		"moduleResolution": "bundler",

		"resolveJsonModule": true,

		/*
		 * `../typings` is this workspace's own, so every ambient declaration
		 * the repo relies on lives beside this config. `@types` packages
		 * still anchor at the repo root, where the install hoists them; that
		 * entry becomes `${configDir}/node_modules/@types` once the repo
		 * switches to a linked install layout (see #75814).
		 */
		"typeRoots": [ "../typings", "../../../node_modules/@types" ],
		"types": [],

		"rootDir": "${configDir}/src",
		"declarationDir": "${configDir}/build-types"
	},
	"include": [ "${configDir}/src" ],
	"exclude": [
		"${configDir}/**/benchmark",
		"${configDir}/build-*/**",
		"${configDir}/build/**",
		"${configDir}/**/test/**",
		"${configDir}/**/tests/**",
		"${configDir}/**/__tests__/**",
		"${configDir}/**/stories/**",
		"${configDir}/**/*.story.*"
	]
}
