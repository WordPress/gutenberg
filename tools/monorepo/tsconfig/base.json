{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"paths": {
			"@wordpress/commands": [
				"../typings/untyped-packages/wordpress-commands.d.ts"
			],
			"@wordpress/block-editor": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/block-library": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/patterns": [
				"../typings/untyped-packages/any-module.d.ts"
			],
			"@wordpress/interface": [
				"../typings/untyped-packages/any-module.d.ts"
			]
		},
		"checkJs": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",
		"target": "esnext",
		"module": "preserve",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,

		"skipLibCheck": true,

		/* Strict Type-Checking Options */
		"strict": true,

		/* Additional Checks */
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,

		/* Module Resolution Options */
		"moduleResolution": "bundler",

		"resolveJsonModule": true,

		/*
		 * `../typings` is this workspace's own. `@types` packages are not:
		 * the install hoists them to the repo root, which is the one place
		 * this config still has to reach outside itself. A linked install
		 * moves them into each workspace (see #75814), and that PR changes
		 * this entry to `${configDir}/node_modules/@types`.
		 */
		"typeRoots": [ "../typings", "../../../node_modules/@types" ],
		"types": [],

		"rootDir": "${configDir}/src",
		"declarationDir": "${configDir}/build-types"
	},
	"include": [ "${configDir}/src" ],
	"exclude": [
		"${configDir}/**/benchmark",
		"${configDir}/build-*/**",
		"${configDir}/build/**",
		"${configDir}/**/test/**",
		"${configDir}/**/tests/**",
		"${configDir}/**/__tests__/**",
		"${configDir}/**/stories/**",
		"${configDir}/**/*.story.*"
	]
}
