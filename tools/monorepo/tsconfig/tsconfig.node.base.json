{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "./tsconfig.dev.base.json",
	"compilerOptions": {
		// Sources and tests alike import by their real extension, which is
		// what Node's type stripping resolves when the script runs.
		"allowImportingTsExtensions": true,
		// Type stripping erases types, it does not compile them: enums,
		// namespaces and parameter properties would fail at runtime.
		"erasableSyntaxOnly": true,
		// Make Node types available by default.
		"types": [ "node" ],
		// These scripts live wherever their workspace keeps them, not under
		// `src`, which is what the build preset this extends assumes.
		"rootDir": "${configDir}"
	}
}
