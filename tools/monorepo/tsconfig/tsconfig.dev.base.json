{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"emitDeclarationOnly": false,
		"checkJs": false,
		"types": [ "gutenberg-vitest-test-env" ]
	},
	/*
	 * JavaScript dev files stay unchecked: `checkJs` would report errors in
	 * files the build never checked either.
	 */
	"include": [
		"${configDir}/src/**/test/**/*.ts",
		"${configDir}/src/**/test/**/*.tsx",
		"${configDir}/src/**/test/**/*.mts",
		"${configDir}/src/**/test/**/*.cts",
		"${configDir}/src/**/tests/**/*.ts",
		"${configDir}/src/**/tests/**/*.tsx",
		"${configDir}/src/**/tests/**/*.mts",
		"${configDir}/src/**/tests/**/*.cts",
		"${configDir}/src/**/__tests__/**/*.ts",
		"${configDir}/src/**/__tests__/**/*.tsx",
		"${configDir}/src/**/__tests__/**/*.mts",
		"${configDir}/src/**/__tests__/**/*.cts",
		"${configDir}/src/**/stories/**/*.ts",
		"${configDir}/src/**/stories/**/*.tsx",
		"${configDir}/src/**/stories/**/*.mts",
		"${configDir}/src/**/stories/**/*.cts",
		"${configDir}/src/**/*.story.ts",
		"${configDir}/src/**/*.story.tsx",
		"${configDir}/src/**/*.story.mts",
		"${configDir}/src/**/*.story.cts"
	],
	"exclude": [ "${configDir}/**/benchmark" ]
}
