install-strategy = "linked"
engine-strict = true
strict-peer-deps = true
prefer-dedupe = true
min-release-age = 1
# fail the install on any dependency script not covered by allowScripts in package.json
strict-allow-scripts = true
# opt in to the npm v12 defaults that refuse git and remote URL dependencies
allow-git = none
allow-remote = none
# extend that to local tarballs
allow-file = none
