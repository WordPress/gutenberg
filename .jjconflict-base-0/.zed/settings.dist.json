{
	"file_scan_exclusions": [ "**/node_modules", "..." ],
	"languages": {
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"eslint",
				"!vtsls",
				"!typescript-language-server",
				"!tailwindcss-language-server",
				"..."
			]
		},
		"JSX": {
			"language_servers": [
				"typescript-ls",
				"eslint",
				"!vtsls",
				"!typescript-language-server",
				"!tailwindcss-language-server",
				"..."
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"eslint",
				"!vtsls",
				"!typescript-language-server",
				"!tailwindcss-language-server",
				"..."
			]
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"eslint",
				"!vtsls",
				"!typescript-language-server",
				"!tailwindcss-language-server",
				"..."
			]
		},
		"CSS": {
			"language_servers": [
				"stylelint-lsp",
				"!tailwindcss-language-server",
				"..."
			],
			"formatter": [
				{
					"code_action": "source.fixAll.stylelint"
				}
			]
		},
		"SCSS": {
			"language_servers": [
				"stylelint-lsp",
				"!tailwindcss-language-server",
				"..."
			],
			"formatter": [
				{
					"code_action": "source.fixAll.stylelint"
				}
			]
		},
		"HTML": {
			"language_servers": [ "!tailwindcss-language-server", "..." ]
		},
		"PHP": {
			"language_servers": [
				"intelephense",
				"phpcs",
				"!phpactor",
				"!phptools",
				"!phpantom",
				"!tailwindcss-language-server",
				"..."
			],
			"formatter": [
				{
					"code_action": "source.fixAll.phpcs"
				}
			]
		}
	},
	"lsp": {
		"typescript-ls": {
			"binary": {
				"path": "node",
				"arguments": [
					"tools/build-scripts/node_modules/@typescript/native/bin/tsc",
					"--lsp",
					"--stdio"
				]
			}
		},
		"stylelint-lsp": {
			"settings": {
				"stylelint": {
					"validate": [ "css", "postcss", "scss" ]
				}
			}
		},
		"intelephense": {
			"settings": {
				"environment": {
					"phpVersion": "7.4.0"
				}
			}
		}
	}
}
