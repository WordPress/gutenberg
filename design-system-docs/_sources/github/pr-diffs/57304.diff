+	} );
+} );
+
+describe.each( [
+	[ 'When LTR', false ],
+	[ 'When RTL', true ],
+] )( '%s', ( _when, rtl ) => {
+	const { previous, next, first, last } = getKeys( rtl );
+
+	function useOneDimensionalTest( initialState?: InitialState ) {
+		const Test = () => (
+			<OneDimensionalTest
