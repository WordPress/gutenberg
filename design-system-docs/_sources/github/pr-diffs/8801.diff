new file mode 100644
index 00000000000000..a8b34fdba0573b
--- /dev/null
+++ b/packages/components/src/spinner/style.scss
@@ -0,0 +1,24 @@
+.components-spinner {
+	display: inline-block;
+	background-color: $dark-gray-200;
+	width: 18px;
+	height: 18px;
+	opacity: 0.7;
+	float: right;
+	margin: 5px 11px 0;
+	border-radius: 100%;
+	position: relative;
+
+	&::before {
+		content: "";
+		position: absolute;
+		background-color: $white;
+		top: 3px;
+		left: 3px;
+		width: 4px;
+		height: 4px;
+		border-radius: 100%;
+		transform-origin: 6px 6px;
+		@include animate_rotation;
+	}
+}
