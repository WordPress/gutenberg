+			loading: [ [], undefined ],
+		} ),
+		[]
+	);
+	const [ keySuffix, setKeySuffix ] = useState( Number.MIN_SAFE_INTEGER );
+	button( 'Replay animation', () => setKeySuffix( ( prevK ) => prevK + 1 ) );
+	const type = radios(
