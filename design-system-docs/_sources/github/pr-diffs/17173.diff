--- /dev/null
+++ b/packages/components-website/src/utils/strings.js
@@ -0,0 +1,18 @@
+/* eslint-disable no-bitwise */
+export function toHash( s ) {
+	let a = 1,
+		c = 0,
+		h,
+		o;
+	if ( s ) {
+		a = 0;
+		for ( h = s.length - 1; h >= 0; h-- ) {
+			o = s.charCodeAt( h );
+			a = ( ( a << 6 ) & 268435455 ) + o + ( o << 14 );
+			c = a & 266338304;
+			a = c !== 0 ? a ^ ( c >> 21 ) : a;
+		}
+	}
+	return String( a );
+}
+/* eslint-enable no-bitwise */
diff --git a/packages/components-website/src/utils/use-data.hooks.js b/packages/components-website/src/utils/use-data.hooks.js
new file mode 100644
index 00000000000000..1f417388b4a7f9
--- /dev/null
+++ b/packages/components-website/src/utils/use-data.hooks.js
@@ -0,0 +1,57 @@
+/**
+ * External dependencies
+ */
+import { useEffect, useState } from 'react';
+import axios from 'axios';
+
+/**
+ * Internal dependencies
+ */
+import { useRouter } from './hooks';
+
+export function getEndpoint( params ) {
+	const { path } = params;
+	const endpoint = `/_data/${ path }/index.json`;
+
+	return endpoint;
+}
+
+export async function fetchAndLoadData( { path, setData, setLoaded } ) {
+	const url = getEndpoint( {
+		path,
+	} );
+
+	try {
+		const { data } = await axios.get( url );
+		if ( ! data ) {
+			return;
+		}
+
+		setData( data );
+		setLoaded( true );
+	} catch ( err ) {
+		// eslint-disable-next-line no-console
+		console.log( err );
+	}
+}
+
+export function useData( pathname ) {
+	const { location } = useRouter();
+	const path = pathname || location.pathname || '';
+
+	const [ data, setData ] = useState( {} );
+	const [ isLoaded, setLoaded ] = useState( false );
+
+	useEffect( () => {
+		fetchAndLoadData( { path, setLoaded, setData } );
+
+		return () => {
+			setLoaded( false );
+		};
+	}, [ path, setLoaded, setData ] );
+
+	return {
+		data,
+		isLoaded,
+	};
+}
