+
+function UnforwardedTreeGridItem(
+	{ children, ...props }: RovingTabIndexItemProps,
+	ref: React.ForwardedRef< any >
+) {
+	return (
+		<RovingTabIndexItem ref={ ref } { ...props }>
+			{ children }
