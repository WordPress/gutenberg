+/**
+ * Internal dependencies
+ */
+import { get } from '../core';
+
+/**
+ * @param {import('react').ReactText} value
+ * @return {string} Spacing.
+ */
+export function space( value ) {
+	return typeof value === 'number'
+		? `calc(${ get( 'gridBase' ) } * ${ value })`
+		: value;
+}
