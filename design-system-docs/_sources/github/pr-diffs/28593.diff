+	test( 'should render active', () => {
+		const { container } = render(
+			<Elevation active={ 5 } hover={ 14 } value={ 7 } />
+		);
+
+		expect( container.firstChild ).toMatchSnapshot();
+	} );
+
+	test( 'should render offset', () => {
+		const { container } = render(
+			<Elevation active={ 5 } hover={ 14 } offset={ -2 } value={ 7 } />
+		);
+
+		expect( container.firstChild ).toMatchSnapshot();
+	} );
+} );
