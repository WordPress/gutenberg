diff --git a/packages/ui/src/menu/styles.module.css b/packages/ui/src/menu/styles.module.css
new file mode 100644
index 00000000000000..9f1e2633e535a8
--- /dev/null
+++ b/packages/ui/src/menu/styles.module.css
@@ -0,0 +1,246 @@
+@layer wp-ui-utilities, wp-ui-components, wp-ui-compositions, wp-ui-overrides;
+
+@layer wp-ui-components {
+	.trigger {
+		display: inline-flex;
+		align-items: center;
+		cursor: var(--wpds-cursor-control);
+	}
+
+	.positioner {
+		z-index: var(--wp-ui-menu-z-index, var(--wp-ui-popover-z-index, 1000000));
+	}
+
+	.popup {
+		--wp-ui-menu-min-width: 160px;
+		--wp-ui-menu-max-width: 320px;
+		--wp-ui-menu-padding: var(--wpds-dimension-padding-xs);
+		--wp-ui-menu-item-min-height: 32px;
+		--wp-ui-menu-item-padding-block: var(--wpds-dimension-padding-xs);
+		--wp-ui-menu-item-padding-inline: var(--wpds-dimension-padding-md);
+		--wp-ui-menu-prefix-min-width: 24px;
+		--wp-ui-menu-prefix-gap: var(--wpds-dimension-gap-sm);
+		--wp-ui-menu-content-gap: var(--wpds-dimension-gap-md);
+		--wp-ui-menu-line-gap: var(--wpds-dimension-gap-xs);
+		--wp-ui-menu-focus-ring-width: 1.5px;
+		--wp-ui-menu-outline-width: 2px;
+		--wp-ui-menu-submenu-chevron-size: 12px;
+
+		position: relative;
+
+		display: grid;
+		grid-template-columns: minmax(0, max-content) 1fr;
+		grid-template-rows: auto;
+
+		box-sizing: border-box;
+		min-width: var(--wp-ui-menu-min-width);
+		max-width: var(--wp-ui-menu-max-width);
+		max-height: var(--popover-available-height);
+		padding: var(--wp-ui-menu-padding);
+
+		overflow: auto;
+		overscroll-behavior: contain;
+
+		background-color: var(--wpds-color-bg-surface-neutral-strong);
+		border:
+			var(--wpds-border-width-xs) solid
+			var(--wpds-color-stroke-surface-neutral-weak);
+		border-radius: var(--wpds-border-radius-md);
+		box-shadow: var(--wpds-elevation-md);
+		color: var(--wpds-color-fg-content-neutral);
+
+		/* Visible only in high contrast mode. */
+		outline: var(--wp-ui-menu-outline-width) solid transparent;
+	}
+
+	.item {
+		all: unset;
+		position: relative;
+		box-sizing: border-box;
+		min-height: var(--wp-ui-menu-item-min-height);
+
+		/* Occupy all menu columns. */
+		grid-column: 1 / -1;
+
+		display: grid;
+		grid-template-columns: minmax(0, max-content) 1fr;
+		align-items: center;
+
+		@supports ( grid-template-columns: subgrid ) {
+			grid-template-columns: subgrid;
+		}
+
+		padding-block: var(--wp-ui-menu-item-padding-block);
+		padding-inline: var(--wp-ui-menu-item-padding-inline);
+		scroll-margin: var(--wp-ui-menu-padding);
+		border-radius: var(--wpds-border-radius-sm);
+		font-family: inherit;
+		font-size: var(--wpds-typography-font-size-md);
+		font-weight: var(--wpds-typography-font-weight-regular);
+		line-height: var(--wpds-typography-line-height-sm);
+		color: inherit;
+
+		cursor: default;
+		user-select: none;
+		outline: none;
+		text-decoration: none;
+	}
+
+	.content {
+		grid-column: 2;
+
+		display: flex;
+		align-items: center;
+		justify-content: space-between;
+		gap: var(--wp-ui-menu-content-gap);
+
+		pointer-events: none;
+	}
+
+	.label {
+		flex: 1;
+		min-width: 0;
+
+		display: inline-flex;
+		flex-direction: column;
+		gap: var(--wp-ui-menu-line-gap);
+
+		overflow: hidden;
+		text-overflow: ellipsis;
+		white-space: nowrap;
+	}
+
+	.itemLabel {
+		display: block;
+		min-width: 0;
+		color: inherit;
+
+		overflow: hidden;
+		text-overflow: ellipsis;
+		white-space: nowrap;
+	}
+
+	.itemHelpText {
+		display: -webkit-box;
+		color: var(--wpds-color-fg-content-neutral-weak);
+		overflow: hidden;
+		overflow-wrap: anywhere;
+		text-overflow: ellipsis;
+		-webkit-box-orient: block-axis;
+		-webkit-line-clamp: 2;
+		line-clamp: 2;
+		white-space: normal;
+	}
+
+	.prefix {
+		grid-column: 1;
+
+		display: flex;
+		align-items: center;
+		justify-content: center;
+
+		color: var(--wpds-color-fg-content-neutral-weak);
+	}
+
+	.prefix:not(:empty) {
+		margin-inline-end: var(--wp-ui-menu-prefix-gap);
+	}
+
+	.indicatorPrefix {
+		/* Keep checkbox/radio rows aligned even when unchecked icons are hidden. */
+		min-width: var(--wp-ui-menu-prefix-min-width);
+		margin-inline-end: var(--wp-ui-menu-prefix-gap);
+	}
+
+	.indicatorPrefix[data-unchecked] svg {
+		opacity: 0;
+	}
+
+	.suffix {
+		flex: 0 1 fit-content;
+		min-width: 0;
+		width: fit-content;
+
+		display: flex;
+		align-items: center;
+		justify-content: center;
+		gap: var(--wp-ui-menu-content-gap);
+
+		color: var(--wpds-color-fg-content-neutral-weak);
+	}
+
+	.submenuChevron {
+		width: var(--wp-ui-menu-submenu-chevron-size);
+		height: var(--wp-ui-menu-submenu-chevron-size);
+		flex: 0 0 auto;
+		margin-inline-start: var(--wpds-dimension-gap-xs);
+		fill: currentColor;
+	}
+
+	.item[aria-disabled="true"] {
+		color: var(--wpds-color-fg-interactive-neutral-disabled);
+		cursor: not-allowed;
+	}
+
+	.item[data-highlighted]:not([data-focus-visible]):not(
+	[aria-disabled="true"]
+) {
+		background-color: var(--wpds-color-bg-interactive-brand-strong);
+		color: var(--wpds-color-fg-interactive-brand-strong);
+	}
+
+	.item[data-focus-visible] {
+		box-shadow:
+			0 0 0 var(--wp-ui-menu-focus-ring-width)
+			var(--wpds-color-stroke-interactive-brand);
+		outline: var(--wp-ui-menu-outline-width) solid transparent;
+	}
+
+	/* Match Components behavior for open submenu trigger item. */
+	.popup
+	:not(:focus) > .item[aria-expanded="true"]:not([data-highlighted]) {
+		background-color: var(--wpds-color-bg-interactive-neutral-weak);
+		color: var(--wpds-color-fg-content-neutral);
+	}
+
+	.item[data-highlighted]:not([data-focus-visible]) .prefix,
+	.item[aria-disabled="true"] .prefix,
+	.item[data-highlighted]:not([data-focus-visible]) .suffix,
+	.item[aria-disabled="true"] .suffix,
+	.item[data-highlighted]:not([data-focus-visible]) .itemHelpText,
+	.item[aria-disabled="true"] .itemHelpText {
+		color: inherit;
+	}
+
+	.group {
+		/* Ignore this wrapper in the parent grid layout. */
+		display: contents;
+	}
+
+	.separator {
+		grid-column: 1 / -1;
+
+		border: 0;
+		height: var(--wpds-border-width-xs);
+		background-color: var(--wpds-color-stroke-surface-neutral-weak);
+		margin-block: var(--wpds-dimension-gap-sm);
+		margin-inline: var(--wp-ui-menu-item-padding-inline);
+
+		outline: var(--wp-ui-menu-outline-width) solid transparent;
+	}
+
+	.groupLabel {
+		grid-column: 1 / -1;
+
+		font-family: var(--wpds-typography-font-family-body);
+		font-size: var(--wpds-typography-font-size-sm);
+		font-weight: var(--wpds-typography-font-weight-medium);
+		line-height: var(--wpds-typography-line-height-xs);
+		text-transform: uppercase;
+		color: var(--wpds-color-fg-content-neutral-weak);
+
+		padding-block-start: var(--wpds-dimension-gap-md);
+		padding-block-end: var(--wpds-dimension-gap-sm);
+		padding-inline: var(--wp-ui-menu-item-padding-inline);
+	}
+}
