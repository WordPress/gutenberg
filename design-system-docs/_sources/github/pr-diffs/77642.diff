+export const Clear = forwardRef< HTMLButtonElement, AutocompleteClearProps >(
+	function Clear( { render = DEFAULT_RENDER, ...restProps }, ref ) {
+		return (
+			<_Autocomplete.Clear
+				ref={ ref }
+				render={ render }
+				{ ...restProps }
+			/>
+		);
+	}
+);
