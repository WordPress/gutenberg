+	...props
+}: AutocompleteClearProps ) => (
+	<IconButton
+		icon={ closeSmall }
+		size="small"
+		variant="minimal"
+		tone="neutral"
+		label={ ariaLabel }
+		{ ...props }
+	/>
+);
+
+/**
+ * A button that clears the input value.
