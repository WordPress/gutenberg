+				expect.any( Function )
+			);
+
+			// Destroy mid-drag without dispatching pointerup.
+			controller.destroy();
+
+			expect( el.removeEventListener ).toHaveBeenCalledWith(
+				'pointermove',
+				expect.any( Function )
+			);
+			expect( el.removeEventListener ).toHaveBeenCalledWith(
+				'pointerup',
+				expect.any( Function )
+			);
+			expect( el.removeEventListener ).toHaveBeenCalledWith(
+				'lostpointercapture',
+				expect.any( Function )
+			);
+		} );
+
+		it( 'does not dispatch if pointermove fires after destroy', () => {
+			const state = makeState( { zoom: 2 } );
