+
+function makeParagraphBlock( content ) {
+	return {
+		clientId: 'block-1',
+		name: 'core/paragraph',
+		attributes: { content },
+		innerBlocks: [],
+	};
+}
+
+function getSelection() {
+	return {
+		selectionStart: {
+			clientId: 'block-1',
+			attributeKey: 'content',
+			offset: TEXT_OFFSET,
+		},
+		selectionEnd: {
+			clientId: 'block-1',
+			attributeKey: 'content',
+			offset: TEXT_OFFSET,
+		},
+	};
