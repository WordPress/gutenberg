+		// After the error, save draft should be re-enabled.
+		await expect( saveDraftButton ).toBeEnabled( { timeout: 10_000 } );
+
+		// Lock should be cleared.
+		await expect
+			.poll(
+				() =>
+					page.evaluate( () =>
+						window.wp.data
+							.select( 'core/editor' )
+							.isPostSavingLocked()
+					),
+				{ timeout: 10_000 }
+			)
+			.toBe( false );
+	} );
+} );
