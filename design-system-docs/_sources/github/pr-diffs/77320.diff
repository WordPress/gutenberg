+
+```js
+import { ready } from '@wordpress/core-abilities';
+import { getAbilities, executeAbility } from '@wordpress/abilities';
+
+await ready;
+
+console.log( getAbilities() );
+console.log( await executeAbility( 'core/get-site-info' ) );
+```
