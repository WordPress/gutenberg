+	} );
+
+	describe( 'isDirty', () => {
+		it( 'should be false initially', () => {
+			const { result } = renderHook( () => useCropperState() );
+
+			expect( result.current.isDirty ).toBe( false );
+		} );
+
+		it( 'should be true after changing crop', () => {
