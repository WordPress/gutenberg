+					const { pan: clampedCrop } = restrictPanZoom(
+						{
+							...s,
+							zoom: newZoom,
+							pan: { x: newCropX, y: newCropY },
+						},
+						getImageSizeFromState( s ),
+						s.cropRect
+					);
