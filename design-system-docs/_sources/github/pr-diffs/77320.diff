+		if ( ! lastTap ) {
+			this.lastTap = { time: now, x: tapX, y: tapY };
+			return false;
+		}
+		const timeDelta = now - lastTap.time;
+		const distDelta = Math.sqrt(
+			( tapX - lastTap.x ) ** 2 + ( tapY - lastTap.y ) ** 2
+		);
+		const isDoubleTap =
+			timeDelta < DOUBLE_TAP_TIME && distDelta < DOUBLE_TAP_DISTANCE;
+		if ( ! isDoubleTap ) {
+			this.lastTap = { time: now, x: tapX, y: tapY };
+			return false;
+		}
