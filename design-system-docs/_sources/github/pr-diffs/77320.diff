+		expect( post.status ).toBe( 'draft' );
+		expect( rawField( post.title ) ).toContain( title );
+		expect( rawField( post.content ) ).toContain( marker );
+		expect( drafts.map( ( draft ) => draft.id ) ).toContain( postId );
+	} );
+} );
