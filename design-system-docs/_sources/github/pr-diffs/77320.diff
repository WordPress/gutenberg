+			apiVersion: 3,
+			title: 'Paragraph',
+			category: 'text',
+			attributes: {
+				content: {
+					type: 'rich-text',
+					source: 'rich-text',
+					selector: 'p',
+					role: 'content',
+				},
+			},
+			edit: () => null,
+			save: ( { attributes } ) => (
