+const IMAGE: Size = { width: 1000, height: 500 };
+
+const START_RECT = { x: 0.2, y: 0.2, width: 0.4, height: 0.6 };
+
+function makeDrag(
+	handle: ResizeDragState[ 'handle' ],
+	startX = 500,
+	startY = 250
+): ResizeDragState {
+	return {
+		handle,
+		startX,
+		startY,
+		startRect: { ...START_RECT },
+	};
+}
+
+describe( 'computeShiftLockedResizeRect', () => {
+	describe( 'corner handles', () => {
