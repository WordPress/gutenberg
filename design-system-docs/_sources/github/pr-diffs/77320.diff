+				const { pan: newCrop } = restrictPanZoom(
+					{
+						...s,
+						pan: {
+							x: touch.startPanX + deltaX,
+							y: touch.startPanY + deltaY,
+						},
+					},
+					getImageSizeFromState( s ),
+					s.cropRect
+				);
