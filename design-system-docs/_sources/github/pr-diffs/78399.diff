+	{ id: '2', value: 'Item 2' },
+	{ id: '3', value: 'Item 3' },
+];
+
+type Item = ( typeof ITEMS )[ number ];
+
+function renderDisabledMultiSelect() {
+	return render(
+		<Combobox.Root< Item, true >
+			items={ ITEMS }
+			multiple
+			disabled
+			defaultValue={ [ ITEMS[ 0 ] ] }
+		>
+			<Combobox.Chips>
+				<Combobox.Value>
