+@layer wp-ui-utilities, wp-ui-components, wp-ui-compositions, wp-ui-overrides;
+
+@layer wp-ui-components {
+	.breadcrumb {
+		min-width: 0;
+	}
+
+	.list {
+		display: flex;
+		align-items: center;
+		gap: 0;
+		list-style: none;
+		margin: 0;
+		padding: 0;
+		min-width: 0;
+		font-family: var(--wpds-typography-font-family-heading);
+		font-size: var(--wpds-typography-font-size-lg);
+		font-weight: var(--wpds-typography-font-weight-medium);
+		line-height: var(--wpds-typography-line-height-lg);
+	}
+
+	.list-item {
+		display: inline-flex;
+		align-items: center;
+		min-width: 0;
+		max-width: 100%;
+		flex-shrink: 1;
+	}
+
+	.list-item:not(:last-child)::after {
+		content: "/";
+		flex: 0 0 auto;
+		margin-inline: var(--wpds-dimension-gap-sm);
+		color: currentColor;
+	}
+
+	.list-item:last-child {
+		flex: 1 1 auto;
+	}
+
+	.content {
+		display: inline-block;
+		min-width: 0;
+		max-width: 100%;
+		overflow: hidden;
+		text-overflow: ellipsis;
+		white-space: nowrap;
+	}
+
+	.item {
+		color: inherit;
+		text-decoration: none;
+	}
+
+	.item:hover {
+		text-decoration: underline;
+	}
+
+	.current {
+		color: inherit;
+	}
+}
