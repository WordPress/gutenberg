@@ -0,0 +1,13 @@
+/**
+ * Internal dependencies
+ */
+import { createComponent } from '../utils';
+import { useControlLabel } from './use-control-label';
+
+const ControlLabel = createComponent( {
+	as: 'label',
+	useHook: useControlLabel,
+	name: 'ControlLabel',
