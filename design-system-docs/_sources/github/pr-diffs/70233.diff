+		// As visually hidden labels are still included in the document
+		// and do not have `display: none` styling, we can't rely on
+		// `.toBeInTheDocument()` or `.toBeVisible()` assertions.
+		expect( label ).toHaveAttribute(
+			'data-wp-component',
+			'VisuallyHidden'
+		);
+	} );
 } );
