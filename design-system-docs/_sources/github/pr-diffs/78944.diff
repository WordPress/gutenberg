@@ -0,0 +1,18 @@
+@layer wp-ui {
+	@layer utilities, components, compositions, overrides;
+
+	@layer components {
+		.link-button {
+			/* Bridge `Button` foreground tokens into the unlayered `.a` global CSS defense. */
+			--_gcd-a-color: var(--wp-ui-button-foreground-color);
+
+			&:visited {
+				--_gcd-a-color: var(--wp-ui-button-foreground-color);
+			}
+
+			&:is(:hover, :active, :focus) {
+				--_gcd-a-color: var(--wp-ui-button-foreground-color-active);
+			}
+		}
+	}
+}
