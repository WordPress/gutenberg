+	const result: Record< string, ManifestComponent > = {};
+	for ( const [ key, value ] of Object.entries( entries ) ) {
+		result[ key ] = {
+			id: key,
+			name: value.name ?? key,
+			path:
+				value.path ??
+				`../packages/ui/src/${ key }/stories/index.story.tsx`,
+			...value,
+		};
+	}
+	return result;
