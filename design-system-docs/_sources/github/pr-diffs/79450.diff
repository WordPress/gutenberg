diff --git a/packages/components/src/flex/style.module.scss b/packages/components/src/flex/style.module.scss
new file mode 100644
index 00000000000000..7f831f0f0156db
--- /dev/null
+++ b/packages/components/src/flex/style.module.scss
@@ -0,0 +1,40 @@
+.flex {
+	align-items: var(--wp-components-flex-align);
+	display: flex;
+	flex-direction: var(--wp-components-flex-direction);
+	flex-wrap: var(--wp-components-flex-wrap);
+	gap: var(--wp-components-flex-gap);
+	justify-content: var(--wp-components-flex-justify);
+
+	&[data-expanded][data-layout="column"] {
+		height: 100%;
+	}
+
+	&[data-expanded][data-layout="row"] {
+		width: 100%;
+	}
+}
+
+.item {
+	display: var(--wp-components-flex-item-display, block);
+	max-height: 100%;
+	max-width: 100%;
+	min-height: 0;
+	min-width: 0;
+}
+
+.block {
+	flex: 1;
+}
+
+.itemsColumn {
+	> * {
+		min-height: 0;
+	}
+}
+
+.itemsRow {
+	> * {
+		min-width: 0;
+	}
+}
