+`;
+
+export const currentColor = css`
+	color: currentColor;
+
+	&:hover,
+	&:focus {
+		color: currentColor;
+	}
+`;
+
+export const split = css`
+	border-bottom-left-radius: 0px;
+	border-top-left-radius: 0px;
+`;
