+	}
+
+	&:focus {
+		border-color: ${ ui.get( 'buttonPrimaryBorderColorFocus' ) };
+	}
+
+	&:active {
+		background-color: ${ ui.get( 'controlBackgroundColorActive' ) };
+	}
+
+	&[data-active='true'] {
+		background: ${ ui.get( 'colorText' ) };
