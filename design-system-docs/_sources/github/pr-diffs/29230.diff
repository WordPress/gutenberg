+	${ ui.padding.x( ui.get( 'controlPaddingXSmall' ) ) };
+	min-height: ${ ui.get( 'controlHeightSmall' ) };
+
+	&[data-icon='true'] {
+		min-width: ${ ui.get( 'controlPaddingXSmall' ) };
+	}
+`;
+
+export const xSmall = css`
