+export const large = css`
+	min-height: calc( ${ CONFIG.controlHeightLarge } - 2px );
+	padding-bottom: calc( ( ${ CONFIG.controlHeightLarge } - 2px - 18px ) / 2 );
+	padding-top: calc( ( ${ CONFIG.controlHeightLarge } - 2px - 18px ) / 2 );
