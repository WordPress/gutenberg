+	user-select: none;
+`;
+
+export const SpinnerArrow = css`
+	background-color: transparent;
+	border-radius: ${ CONFIG.controlBorderRadius };
+	color: ${ COLORS.darkGray };
+	cursor: pointer;
+	padding: 0 2px;
+
+	&:hover:active {
