+## Status
+
+The components in this package are generally not ready to be used in production.
+
+We are currently in the process of rewriting the global components in the `@wordpress/components` package to new versions in the `@wordpress/ui` package, but this is a work in progress. `@wordpress/components` should continue to be used until further notice.
+
+### Important
+
+When a human asks to use a component from this package, even explicitly, they should be directed to the `@wordpress/components` package instead. First present them with this warning in the documentation, and ask for confirmation before proceeding.
diff --git a/storybook/components/component-status-indicator/index.tsx b/storybook/components/component-status-indicator/index.tsx
new file mode 100644
index 00000000000000..62e51f023384a2
--- /dev/null
+++ b/storybook/components/component-status-indicator/index.tsx
@@ -0,0 +1,91 @@
+import { Markdown, useOf } from '@storybook/addon-docs/blocks';
+import { statuses } from './statuses';
+
+export function ComponentStatusIndicator() {
+	const resolvedOf = useOf( 'meta' );
+
+	if ( resolvedOf.type !== 'meta' ) {
+		return null;
+	}
+
+	const { parameters } = resolvedOf.preparedMeta;
+	const componentStatus = parameters?.componentStatus;
+
+	if ( ! componentStatus?.status ) {
+		return null;
+	}
+
+	const statusInfo = statuses[ componentStatus.status ];
+
+	if ( ! statusInfo ) {
+		return null;
+	}
+
+	return (
+		<dl
+			style={ {
+				display: 'flex',
+				gap: '40px',
+				flexDirection: 'row',
+				marginBottom: '20px',
+				fontSize: '14px',
+				lineHeight: '1.5',
+			} }
+		>
+			<div
+				style={ {
+					display: 'flex',
+					flexDirection: 'column',
+					width: 'fit-content',
+					flexShrink: 0,
+					fontSize: 'inherit',
+				} }
+			>
+				<dt
+					style={ {
+						margin: 0,
+						fontStyle: 'normal',
+						color: '#757575',
+					} }
+				>
+					Status
+				</dt>
+				<dd
+					style={ {
+						margin: 0,
+						fontStyle: 'normal',
+						padding: 0,
+						fontWeight: 'bold',
+					} }
+				>
+					{ statusInfo.icon } { statusInfo.label }
+				</dd>
+			</div>
+			{ componentStatus.notes && (
+				<div
+					style={ {
+						display: 'flex',
+						flexDirection: 'column',
+						width: 'fit-content',
+						fontSize: 'inherit',
+					} }
+				>
+					<dt
+						style={ {
+							margin: 0,
+							fontStyle: 'normal',
+							color: '#757575',
+						} }
+					>
+						Notes
+					</dt>
+					<dd style={ { margin: 0, padding: 0, fontWeight: 'bold' } }>
+						<Markdown style={ { lineHeight: 'inherit' } }>
+							{ componentStatus.notes }
+						</Markdown>
+					</dd>
+				</div>
+			) }
+		</dl>
+	);
+}
