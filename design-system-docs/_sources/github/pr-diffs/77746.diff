+	// 75% alpha matches the Dialog/Drawer/Popover backdrop opacity. Baked
+	// into the color (instead of the `opacity` property) so the fade-in
+	// animation below still ramps from 0 → fully opaque token color.
+	background-color: color-mix(in srgb, var(--wpds-color-bg-surface-neutral-weak), transparent 25%);
 	z-index: z-index(".components-modal__screen-overlay");
 	display: flex;
