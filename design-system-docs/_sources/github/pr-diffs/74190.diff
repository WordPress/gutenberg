+		margin: 0;
+		font-family: var(--wpds-font-family-body);
+		font-size: var(--wpds-font-size-small);
+		line-height: var(--wpds-font-line-height-x-small);
+		color: var(--wpds-color-fg-content-neutral-weak);
+	}
+}
