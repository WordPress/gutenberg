+	function EmptyStateVisual( { render, ...props }, ref ) {
+		const className = clsx( styles.visual );
+
+		const element = useRender( {
+			defaultTagName: 'div',
+			render,
+			ref,
+			props: mergeProps< 'div' >( { className }, props ),
