diff --git a/packages/components/src/truncate/style.module.scss b/packages/components/src/truncate/style.module.scss
new file mode 100644
index 00000000000000..2585562d824548
--- /dev/null
+++ b/packages/components/src/truncate/style.module.scss
@@ -0,0 +1,21 @@
+.truncate {
+	display: block;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.is-line-clamp {
+	/* stylelint-disable-next-line plugin/use-logical-properties-and-values -- -webkit-line-clamp requires this legacy physical value. */
+	-webkit-box-orient: vertical;
+	-webkit-line-clamp: var(--wp-components-truncate-lines);
+	display: -webkit-box;
+	overflow: hidden;
+
+	// The `word-break: break-all` property first makes sure a text line
+	// breaks even when it contains 'unbreakable' content such as long URLs.
+	// See https://github.com/WordPress/gutenberg/issues/60860.
+	&.is-single-line {
+		word-break: break-all;
+	}
+}
