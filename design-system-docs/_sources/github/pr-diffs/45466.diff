+				)
+			) }
+			{ !! contrastIssues.length && (
+				<>
+					<h2>Contrast issues</h2>
+					<ul>
+						{ contrastIssues.map( ( [ key, error ] ) => (
+							<li key={ key }>{ error }</li>
+						) ) }
+					</ul>
+				</>
+			) }
+		</>
+	);
+};
+ColorScheme.args = {
