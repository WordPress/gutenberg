+
+/**
+ * Internal dependencies
+ */
+import DatePicker from '../date';
+
+export default {
+	title: 'Components/DatePicker',
+	component: DatePicker,
+};
+
+const DatePickerInstance = ( { currentDate, onChange } ) => {
+	return <DatePicker currentDate={ currentDate } onChange={ onChange } />;
+};
