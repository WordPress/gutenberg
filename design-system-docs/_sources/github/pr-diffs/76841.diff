+
+import * as Dialog from '../dialog';
+import type { TriggerProps } from './types';
+
+/**
+ * Renders a button that opens the confirmation dialog when clicked.
+ */
+const Trigger = forwardRef< HTMLButtonElement, TriggerProps >(
