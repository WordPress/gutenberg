+export const REACT_TYPEOF_KEY = '$$typeof';
+export const COMPONENT_NAMESPACE = 'data-wp-component';
+export const CONNECTED_NAMESPACE = 'data-wp-c16t';
+export const CONTEXT_COMPONENT_NAMESPACE = 'data-wp-c5tc8t';
