+export type ToggleMultipleGroupControlOptionIconProps =
+	ToggleGroupControlOptionIconProps & {
+		/**
+		 * Whether the button is pressed.
+		 *
+		 * @default false
+		 */
+		isPressed: boolean;
+		/**
+		 * Listen to click events to manage the `isPressed` state.
