+			/>
+		</ToggleMultipleGroupControl>
+	);
+};
+
+describe( 'ToggleMultipleGroupControl', () => {
+	it( 'should allow multiple selection', async () => {
+		const user = userEvent.setup( {
+			advanceTimers: jest.advanceTimersByTime,
+		} );
+
+		render( <TestComponent /> );
+
