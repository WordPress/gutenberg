+export function useDeprecatedButtonProps( {
+	variant,
+	isPrimary,
+	isTertiary,
+	isSecondary,
+	isLink,
+	isDefault,
+	isSmall,
+	isBusy,
+	isLoading,
+	isActive,
+	isPressed,
+	label,
+	'aria-label': ariaLabel,
+	describedBy,
+	shortcut,
+	tooltipPosition,
+	tooltip,
+	text,
+	pre,
+	size,
+	icon,
+	...props
