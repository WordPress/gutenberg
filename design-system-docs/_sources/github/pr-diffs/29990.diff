+function getIsActive( { isPressed, isActive } ) {
+	if ( typeof isPressed !== 'undefined' ) {
+		deprecated( 'Button isPressed', { alternative: 'Button isActive' } );
+		return isPressed;
+	}
+	return isActive;
+}
