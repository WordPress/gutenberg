+function getIsLoading( { isBusy, isLoading } ) {
+	if ( typeof isBusy !== 'undefined' ) {
+		deprecated( 'Button isBusy', { alternative: 'Button isLoading' } );
+		return isBusy;
+	}
+	return isLoading;
+}
