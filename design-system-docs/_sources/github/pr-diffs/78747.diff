-		( select ) => {
-			const { getBlockParents, getTemplateLock, getBlockRootClientId } =
-				select( blockEditorStore );
-			return {
-				nestingLevel: getBlockParents( clientId )?.length,
-				parentLock: getTemplateLock( getBlockRootClientId( clientId ) ),
-			};
-		},
