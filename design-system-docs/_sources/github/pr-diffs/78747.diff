-		if ( ! isScrollActive.value ) {
-			isScrollActive.value = dragDistance > 0;
-		} else if ( y > dragStartY.value ) {
-			// User is dragging downwards.
-			velocityY.value = VELOCITY_MULTIPLIER * distancePercentage;
-		} else if ( y < dragStartY.value ) {
-			// User is dragging upwards.
-			velocityY.value = -VELOCITY_MULTIPLIER * distancePercentage;
-		} else {
