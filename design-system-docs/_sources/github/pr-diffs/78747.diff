-		?.filter( ( v ) => v !== '' );
-
-	if ( splitValue ) {
-		return {
-			valueToConvert: splitValue[ 1 ],
-			valueUnit: unit || splitValue[ 2 ],
-		};
-	}
-	return undefined;
-};
-
-const convertUnitToMobile = ( containerSize, globalStyles, value, unit ) => {
-	const { width, height } = containerSize;
