-const parseStacktraceLine = ( line ) => {
-	const parts = stacktraceLineRegex.exec( line );
-
-	if ( ! parts ) {
-		return;
-	}
-
-	let filename = parts[ 2 ];
-	const func = parts[ 1 ] || UNKNOWN_FUNCTION;
-	const lineno = parts[ 3 ] ? +parts[ 3 ] : undefined;
-	let colno = parts[ 4 ] ? +parts[ 4 ] : undefined;
