-				);
-				return file;
-			}
-
-			console.log(
-				`Using compiled file "${ compiledFile }" for Typescript file "${ file }"`
-			);
-			return compiledFile;
-		}
-		return file;
-	} );
-
-	// Copy source files to target directory
-	try {
-		sourceFiles.forEach( ( sourceFile ) =>
-			copyFileToDir( sourceFile, targetDir )
-		);
