-	);
-
-	const majorVersion = requiredVersion.split( '.' )[ 0 ];
-	return runtimes
-		.reverse()
-		.filter(
-			( { name, isAvailable, version } ) =>
-				name.startsWith( 'iOS' ) &&
-				new RegExp( `^${ majorVersion }(\\.\\d+)*$` ).test( version ) &&
-				isAvailable
-		);
-};
-
-const PLATFORM_NAME = isAndroid() ? 'Android' : 'iOS';
