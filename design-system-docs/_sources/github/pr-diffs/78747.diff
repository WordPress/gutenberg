-		desiredCaps.newCommandTimeout = SAUCE_LABS_TIMEOUT;
-		desiredCaps.app = `storage:filename=Gutenberg-${ safeBranchName }.app.zip`; // App should be preloaded to sauce storage, this can also be a URL.
-		if ( isLocalEnvironment() ) {
