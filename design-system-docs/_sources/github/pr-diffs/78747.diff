-	if ( property === 'background-color' ) {
-		const { backgroundColor, baseColors } = style;
-
-		if ( backgroundColor !== 'transparent' ) {
-			return backgroundColor;
-		} else if ( baseColors && baseColors?.color?.background ) {
-			return baseColors?.color?.background;
-		}
-
-		return 'transparent';
-	}
