-	const { fontSize = 16 } = globalStyles || {};
-
-	if ( valueToConvert === undefined ) {
-		return undefined;
-	}
-
-	switch ( valueUnit ) {
-		case 'rem':
-		case 'em':
-			return valueToConvert * fontSize;
-		case '%':
-			return Number( valueToConvert / 100 ) * width;
-		case 'px':
-			return Number( valueToConvert );
