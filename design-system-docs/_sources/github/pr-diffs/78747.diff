- */
-function UncontrolledInnerBlocks( props ) {
-	const {
-		clientId,
-		allowedBlocks,
-		prioritizedInserterBlocks,
-		defaultBlock,
-		directInsert,
-		__experimentalDefaultBlock,
-		__experimentalDirectInsert,
-		template,
-		templateLock,
-		templateInsertUpdatesSelection,
-		__experimentalCaptureToolbars: captureToolbars,
