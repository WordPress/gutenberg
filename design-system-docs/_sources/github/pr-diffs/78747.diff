-		}
-	}
-
-	if ( styles.length ) {
-		attributes.style = styles.join( ';' );
-	}
-	if ( classNames.length ) {
-		attributes.class = classNames.join( ' ' );
-	}
-
-	const format = { type: name, attributes };
-	const hasNoSelection = value.start === value.end;
