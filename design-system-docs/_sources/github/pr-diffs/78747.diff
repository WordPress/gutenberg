-    func toggleHTMLMode(_ action: UIAlertAction) {
-        if !htmlMode {
-            self.gutenbergDidRequestToggleUndoButton(true)
-            self.gutenbergDidRequestToggleRedoButton(true)
-        }
-        htmlMode = !htmlMode
-        gutenberg.toggleHTMLMode()
-    }
