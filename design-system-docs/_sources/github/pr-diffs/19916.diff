+			onShow();
+		}
+	}, [] );
+
+	const handleOnMouseLeave = useCallback( ( event ) => {
+		onMouseLeave( event );
+
+		timeoutRef.current = setTimeout( () => {
+			setShow( false );
+			onHide();
+		}, timeout );
