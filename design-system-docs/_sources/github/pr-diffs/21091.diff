+	display: grid;
+	grid-template-columns: repeat( 3, 1fr );
+`;
+
+const pointActive = ( { isActive } ) => {
+	const boxShadow = isActive ? `0 0 0 2px ${ color( 'black' ) }` : null;
+	const pointColor = isActive ? color( 'black' ) : color( 'lightGray.800' );
+	const pointColorHover = isActive
+		? color( 'black' )
