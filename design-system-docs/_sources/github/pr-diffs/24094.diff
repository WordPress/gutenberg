diff --git a/packages/components/src/styled-provider/index.js b/packages/components/src/styled-provider/index.js
new file mode 100644
index 00000000000000..44ca7a3b2a5ae2
--- /dev/null
+++ b/packages/components/src/styled-provider/index.js
@@ -0,0 +1,23 @@
+/**
+ * External dependencies
+ */
+import createEmotionCache from '@emotion/cache';
+import { CacheProvider } from '@emotion/core';
+import stylisPluginCssVariables from 'stylis-plugin-css-variables';
+import memoize from 'memize';
+
+const createCustomCache = memoize( () => {
+	return createEmotionCache( {
+		stylisPlugins: [ stylisPluginCssVariables() ],
+	} );
+} );
+
+function StyledProvider( { children, ...props } ) {
+	return (
+		<CacheProvider { ...props } value={ createCustomCache() }>
+			{ children }
+		</CacheProvider>
+	);
+}
+
+export default StyledProvider;
