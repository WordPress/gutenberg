+
+				// If the previously selected tab is reenabled, it should not
+				// be reselected.
+				expect(
+					screen.queryByRole( 'tab', { selected: true } )
+				).not.toBeInTheDocument();
+				// No tabpanel should be rendered either
+				expect(
+					screen.queryByRole( 'tabpanel' )
+				).not.toBeInTheDocument();
+			} );
+		} );
+	} );
+} );
