+		assert.deepEqual( result, {
+			buildModeBefore: BUILD_MODE.MISSING,
+			buildModeAfter: BUILD_MODE.PLUGIN,
+			rebuilt: true,
+		} );
+		assert.equal( getBuildMode( rootDir ), BUILD_MODE.PLUGIN );
+		assert.equal( spawnStub.calls.length, 1 );
+	} ) );
