+	return (
+		[ DISTRIBUTED_EDITING_HUMAN_LOOP_STEPS.REVIEW_CHANGES ].includes(
+			step
+		) ||
+		[
+			'apply_local_changes',
+			'prepare_changes',
+			'check_with_wordpress',
+			'compare_conflicting_changes',
+			'prepare_save',
+		].includes( action )
