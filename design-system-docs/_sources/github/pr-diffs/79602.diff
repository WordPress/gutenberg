+
+	if ( summary.droppedItemCount < 1 ) {
+		return `Recorded ${ eventText }.`;
+	}
+
+	const droppedText =
+		summary.droppedItemCount === 1
+			? '1 unsafe entry was dropped'
+			: `${ summary.droppedItemCount } unsafe entries were dropped`;
+
+	return `Recorded ${ eventText }; ${ droppedText }.`;
