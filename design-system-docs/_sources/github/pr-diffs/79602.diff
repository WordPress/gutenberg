+		result.snapshotAttempted = true;
+
+		try {
+			result.snapshot =
+				await dispatch.__experimentalRefreshDistributedEditingPresenceSnapshot();
+			result.presenceUpdated = true;
+		} catch ( error ) {
+			result.snapshotError = error;
+		}
+	}
