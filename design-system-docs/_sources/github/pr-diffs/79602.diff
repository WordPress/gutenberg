+
+function getDistributedEditingPendingGhostPlacementForBlockPath(
+	item = {},
+	blockPath = [],
+	options = {}
+) {
+	const itemPath = getDistributedEditingNormalizedBlockPath( item.blockPath );
+
+	if ( itemPath.length === 0 || itemPath.length !== blockPath.length ) {
+		return null;
+	}
