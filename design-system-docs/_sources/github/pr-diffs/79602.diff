+		retrySaveRevisionCreated: normalized.retrySaveRevisionCreated,
+		retrySaveCreatedRevisionIds: normalized.retrySaveCreatedRevisionIds,
+		retrySaveConfirmedMergedEdits: normalized.retrySaveConfirmedMergedEdits,
