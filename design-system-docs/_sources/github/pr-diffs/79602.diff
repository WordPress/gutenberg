+	const itemParentPath = itemPath.slice( 0, -1 );
+	const blockParentPath = blockPath.slice( 0, -1 );
+
+	if (
+		! getDistributedEditingBlockPathsMatch(
+			itemParentPath,
+			blockParentPath
+		)
