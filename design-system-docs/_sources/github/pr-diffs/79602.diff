-
-type UndoMetaHandlers = Pick<
-	RecordHandlers,
-	'addUndoMeta' | 'restoreUndoMeta'
->;
-
-interface StackItemEvent {
-	stackItem: { meta: Map< any, any > };
-	origin: any;
-	type: 'undo' | 'redo';
-	changedParentTypes: Map< Y.AbstractType< any >, Y.YEvent< any >[] >;
