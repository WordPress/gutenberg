-
-		const adjacentThread = nextThread ?? prevThread;
-		if ( adjacentThread ) {
-			selectNote( adjacentThread.id );
-			focusNoteThread( adjacentThread.id, sidebarRef.current );
-			if ( adjacentThread.blockClientId ) {
