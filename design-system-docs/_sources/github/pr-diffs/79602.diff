+	for ( const entry of Array.isArray( rosterEntries ) ? rosterEntries : [] ) {
+		if (
+			entry?.relationship === 'current_user_current_tab' ||
+			! entry?.pendingPreview?.available ||
+			! Array.isArray( entry.pendingPreview.items )
+		) {
+			continue;
+		}
