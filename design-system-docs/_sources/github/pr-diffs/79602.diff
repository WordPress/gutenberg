+	const transcript =
+		getDistributedEditingActionTranscriptStateForSessionState(
+			sessionState
+		);
+	const eventTypes = transcript.items.map( ( item ) => item.eventType );
+	const eventSources = transcript.items.map( ( item ) => item.source );
