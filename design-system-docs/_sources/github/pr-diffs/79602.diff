-			}
-		} );
-
-		observer.observe( container, { childList: true, subtree: true } );
-
-		// Stop trying after 3 seconds.
-		timer = setTimeout( () => {
-			observer.disconnect();
-			resolve( null );
-		}, 3000 );
-	} );
-}
-
-/**
- * Focus a note thread (or a descendant) and scroll it into view.
- *
- * @param {string}       noteId             Note thread ID.
