+export function getDistributedEditingPendingGhostEntriesForBlockPath(
+	rosterEntries = [],
+	blockPath = [],
+	options = {}
+) {
+	const normalizedBlockPath =
+		getDistributedEditingNormalizedBlockPath( blockPath );
