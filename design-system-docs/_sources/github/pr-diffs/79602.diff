-	 * @return {any?} Returns StackItem if a change was applied
-	 */
-	redo() {
-		return popStackItem( this, 'redo' );
-	}
-
-	clear( clearUndoStack = true, clearRedoStack = true ) {
-		/* c8 ignore next */
