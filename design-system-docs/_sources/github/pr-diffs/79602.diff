-	// A thread without a noteId is a new note thread.
-	const threadSelector =
-		noteId && noteId !== 'new'
-			? `[role=treeitem][id="note-thread-${ noteId }"]`
-			: '[role=treeitem]:not([id])';
-	const selector = additionalSelector
-		? `${ threadSelector } ${ additionalSelector }`
