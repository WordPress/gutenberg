-function filler( wordCount: number, seed: number = 0 ): string {
-	const words: string[] = [];
-	let idx = seed;
-	while ( words.length < wordCount ) {
-		const sentence = SENTENCES[ idx % SENTENCES.length ];
-		for ( const w of sentence.split( /\s+/ ) ) {
-			if ( words.length >= wordCount ) {
-				break;
-			}
-			words.push( w );
-		}
-		idx++;
-	}
-	return words.join( ' ' );
-}
