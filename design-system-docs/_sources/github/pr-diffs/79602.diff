-			setRecomputeToken( ( t ) => t + 1 );
-		}, delayMs );
-		return () => {
-			if ( timeoutRef.current ) {
-				clearTimeout( timeoutRef.current );
-			}
-		};
-	}, [ delayMs ] );
-
-	return [ recomputeToken, rerenderAfterDelay ];
-}
