{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install VS Code settings",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"install-vscode-settings",
				"--workspace",
				"@wordpress/dev-setup"
			],
			"runOptions": {
				"runOn": "folderOpen"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"close": true
			}
		}
	]
}
