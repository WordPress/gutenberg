{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/dev.base.json",
	/* Route tests live beside the route sources, not under src. */
	"compilerOptions": {
		"rootDir": ".",
		"composite": false,
		"types": [ "gutenberg-vitest-test-env" ]
	},
	"include": [ "**/test/**/*.ts" ],
	"exclude": [ "build", "node_modules" ]
}
