{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"rootDir": ".",
		"noEmit": true,
		"emitDeclarationOnly": false,
		"composite": false,
		"types": []
	},
	"references": [ { "path": "../../packages/private-apis" } ],
	"include": [ "**/*.ts", "**/*.tsx" ],
	"exclude": [ "build", "node_modules" ]
}
