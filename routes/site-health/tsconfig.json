{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"rootDir": ".",
		"noEmit": true,
		"emitDeclarationOnly": false,
		"composite": false,
		"types": []
	},
	"references": [
		{ "path": "../../packages/admin-ui/tsconfig.build.json" },
