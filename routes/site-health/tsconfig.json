		{ "path": "../../packages/element/tsconfig.build.json" },
		{ "path": "../../packages/i18n/tsconfig.build.json" },
		{ "path": "../../packages/ui/tsconfig.build.json" }
	],
	"include": [ "**/*.ts", "**/*.tsx" ],
	"exclude": [ "build", "node_modules" ]
}
