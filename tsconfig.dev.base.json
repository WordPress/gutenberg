{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"emitDeclarationOnly": false,
		"checkJs": false,
		"types": [ "jest" ]
	},
	/*
	 * JavaScript dev files stay unchecked: `checkJs` would report errors in
	 * files the build never checked either.
	 */
	"include": [
		"${configDir}/src/**/test/**/*.ts",
		"${configDir}/src/**/test/**/*.tsx",
		"${configDir}/src/**/tests/**/*.ts",
		"${configDir}/src/**/tests/**/*.tsx",
		"${configDir}/src/**/__tests__/**/*.ts",
		"${configDir}/src/**/__tests__/**/*.tsx",
		"${configDir}/src/**/stories/**/*.ts",
		"${configDir}/src/**/stories/**/*.tsx",
		"${configDir}/src/**/*.story.ts",
		"${configDir}/src/**/*.story.tsx"
	],
	"exclude": [ "**/benchmark" ]
}
