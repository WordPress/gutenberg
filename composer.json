{
	"name": "wordpress/gutenberg",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"description": "Prototyping since 1440. Development hub for the editor focus in core.",
	"homepage": "https://wordpress.github.io/gutenberg/",
	"keywords": [
		"gutenberg",
		"wordpress",
		"editor",
		"wp",
		"react",
		"javascript"
	],
	"support": {
		"issues": "https://github.com/WordPress/gutenberg/issues"
	},
	"config": {
		"process-timeout": 0,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		},
		"platform": {
			"php": "7.4"
		},
		"policy": {
			"advisories": {
				"ignore-id": {
					"PKSA-z3gr-8qht-p93v": "CVE-2026-24765: unsafe deserialization in PHPUnit's PHPT-format code-coverage handling. The .phpt format is not used in this repository.",
					"PKSA-mh9b-91zm-m1gy": "CVE-2026-45293 only affects the WordPress.WP.EnqueuedResourceParameters sniff included in the WordPress and WordPress-Extra rulesets, all of which are not used."
				}
			}
		}
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"squizlabs/php_codesniffer": "^3.5",
		"phpcompatibility/php-compatibility": "^9.3",
		"wp-coding-standards/wpcs": "^2.2",
		"sirbrillig/phpcs-variable-analysis": "^2.8",
		"wp-phpunit/wp-phpunit": "^5.4",
		"phpunit/phpunit": "^7.5"
	},
	"require": {
		"composer/installers": "~1.0",
		"php": ">=5.6.20"
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
		"lint": "phpcs --standard=phpcs.xml.dist --runtime-set ignore_warnings_on_exit 1",
		"test": "phpunit"
	}
}
