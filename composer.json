{
	"name": "wordpress/gutenberg",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"description": "Prototyping since 1440. Development hub for the editor focus in core.",
	"homepage": "https://wordpress.github.io/gutenberg/",
	"keywords": [
		"gutenberg",
		"wordpress",
		"editor",
		"wp",
		"react",
		"javascript"
	],
	"support": {
		"issues": "https://github.com/WordPress/gutenberg/issues"
	},
	"config": {
		"process-timeout": 0,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true,
			"phpstan/extension-installer": true
		},
		"lock": false
	},
	"require-dev": {
		"phpcompatibility/phpcompatibility-wp": "^2.1.3",
		"wp-coding-standards/wpcs": "^3.4.1",
		"squizlabs/php_codesniffer": "^3.13.6",
		"sirbrillig/phpcs-variable-analysis": "^2.8",
		"spatie/phpunit-watcher": "^1.23",
		"yoast/phpunit-polyfills": "^1.1.0",
		"gutenberg/gutenberg-coding-standards": "@dev",
		"phpstan/extension-installer": "1.4.3",
		"phpstan/phpstan": "2.3.2",
		"phpstan/phpstan-phpunit": "2.1.1",
		"php-stubs/wordpress-stubs": "@dev",
		"php-stubs/wordpress-tests-stubs": "7.1.0",
		"szepeviktor/phpstan-wordpress": "2.0.4"
	},
	"autoload-dev": {
		"psr-4": {
			"Gutenberg\\PHPStan\\": "tools/phpstan/src/"
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "./test/php/gutenberg-coding-standards",
			"options": {
				"symlink": false
			}
		},
		{
			"type": "path",
			"url": "./tools/phpstan/wordpress-stubs",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"phpstan": "tools/phpstan/generate-wordpress-stubs.sh && phpstan analyse --memory-limit=2G",
		"phpstan:baselines": "@phpstan --configuration=phpstan.neon.dist --generate-baseline=tools/phpstan/baseline.neon --allow-empty-baseline",
		"phpstan:generate-wordpress-stubs": "tools/phpstan/generate-wordpress-stubs.sh",
		"test": "phpunit",
		"test:watch": "phpunit-watcher watch < /dev/tty"
	}
}
