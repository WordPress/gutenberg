{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"rootDir": ".."
	},
	"references": [],
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.mts",
		"**/*.cts",
		"../packages/*/src/**/*"
	],
	// Override the base exclusions to admit stories without also admitting tests.
	"exclude": [
		"../**/benchmark",
		"../**/test/**",
		"../**/tests/**",
		"../**/__tests__/**"
	]
}
