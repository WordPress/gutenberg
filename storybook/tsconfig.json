{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "@wordpress/monorepo-tools/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"rootDir": ".",
		"noEmit": true,
		"types": []
	},
	"include": [
		"**/*.tsx",
		"**/*.ts",
		"**/*.mts",
		"**/*.cts",
		"**/*.mjs",
		"**/*.cjs"
	],
	"exclude": [
		"scripts/inject-legacy-docgen.mjs",
		"scripts/sanitize-components-manifest.mjs"
	]
}
